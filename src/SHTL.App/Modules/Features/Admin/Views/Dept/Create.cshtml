@model CreateDeptRequest
@{
    ViewData["Title"] = "Tạo phòng ban";
    var parentOptions = ViewBag.ParentOptions as IReadOnlyList<DeptSelectOption> ?? Array.Empty<DeptSelectOption>();
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-area="admin" asp-controller="Home" asp-action="Index">Tổng quan</a></li>
    <li class="breadcrumb-item"><a asp-area="admin" asp-controller="Dept" asp-action="Index">Phòng ban</a></li>
    <li class="breadcrumb-item active">Tạo mới</li>
}
<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;background:var(--primary-light);color:var(--primary);border-radius:8px;"><i class="fas fa-sitemap"></i></div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Tạo phòng ban</h6>
                    <div class="text-muted small">Tên, mã, mô tả và phòng ban cha (nếu có).</div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-figma">
        <div class="card-content-figma">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group-figma">
                    <label asp-for="Name" class="label-figma"></label>
                    <input asp-for="Name" class="form-control" autocomplete="organization" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="form-group-figma">
                    <label asp-for="Code" class="label-figma"></label>
                    <input asp-for="Code" class="form-control" />
                </div>
                <div class="form-group-figma">
                    <label asp-for="ParentId" class="label-figma"></label>
                    <select asp-for="ParentId" class="form-control">
                        <option value="">— Không có (cấp gốc) —</option>
                        @foreach (var o in parentOptions)
                        {
                            <option value="@o.Id">@o.Label</option>
                        }
                    </select>
                </div>
                <div class="form-group-figma">
                    <label asp-for="Describe" class="label-figma"></label>
                    <textarea asp-for="Describe" class="form-control" rows="3"></textarea>
                </div>
                <div class="d-flex flex-wrap" style="gap:8px;">
                    <button type="submit" class="btn-figma btn-figma-primary">Lưu</button>
                    <a asp-action="Index" class="btn-figma btn-figma-outline">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
