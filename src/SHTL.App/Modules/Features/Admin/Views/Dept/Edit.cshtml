@model UpdateDeptRequest
@{ ViewData["Title"] = "Sửa phòng ban"; }
@section Breadcrumb { <li class="breadcrumb-item"><a asp-action="Index">Phòng ban</a></li><li class="breadcrumb-item active">Sửa</li> }
<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;background:var(--primary-light);color:var(--primary);border-radius:8px;"><i class="fas fa-sitemap"></i></div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Sửa phòng ban</h6>
                    <div class="text-muted small">Cập nhật thông tin phòng ban.</div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-figma">
        <div class="card-content-figma">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="form-group-figma">
                    <label asp-for="Name" class="label-figma"></label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="form-group-figma">
                    <label asp-for="Code" class="label-figma"></label>
                    <input asp-for="Code" class="form-control" />
                </div>
                <div class="form-group-figma">
                    <label asp-for="ParentId" class="label-figma"></label>
                    <input asp-for="ParentId" class="form-control" />
                </div>
                <div class="d-flex flex-wrap" style="gap:8px;">
                    <button type="submit" class="btn-figma btn-figma-primary">Lưu</button>
                    <a asp-action="Index" class="btn-figma btn-figma-outline">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
