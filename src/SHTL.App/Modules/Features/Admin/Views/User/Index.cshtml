@model PaginatedResult<UserDto>
@{
    ViewData["Title"] = "Người dùng";
    var search = ViewBag.Search as string ?? "";
    var meId = (int)(ViewData["MeUserId"] ?? 0);
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Tổng quan</a></li>
    <li class="breadcrumb-item active">Người dùng</li>
}
<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:var(--primary-light);color:var(--primary);border-radius:6px;"><i class="fas fa-users"></i></div>
                <div><h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Quản lý người dùng</h6><div class="text-muted small">Danh sách tài khoản hệ thống</div></div>
            </div>
            <a asp-action="Create" class="btn-figma btn-figma-primary btn-sm"><i class="fas fa-plus mr-1"></i>Thêm mới</a>
        </div>
    </div>
    <div class="frame-figma frame-figma-combined">
        <div class="frame-filter">
            <form method="get" class="d-flex align-items-center flex-wrap" style="gap:8px;">
                <div class="search-input-figma" style="min-width:260px;">
                    <input type="text" name="q" value="@search" placeholder="Tìm tên, email, tài khoản..." />
                    <i class="fas fa-search search-icon"></i>
                </div>
                <input type="hidden" name="size" value="@Model.PageSize" />
                <button type="submit" class="btn-figma btn-figma-primary">Tìm kiếm</button>
            </form>
        </div>
        <div class="p-3">
            @if (!Model.Items.Any())
            {
                <div class="alert alert-light border mb-0">Không có người dùng.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover table-figma">
                        <thead class="table-light">
                            <tr>
                                <th style="width:50px;">STT</th>
                                <th>Tài khoản</th>
                                <th>Họ tên</th>
                                <th>Email</th>
                                <th>Phòng ban</th>
                                <th>Vai trò</th>
                                <th style="width:90px;">Hoạt động</th>
                                <th style="width:80px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int stt = (Model.PageIndex - 1) * Model.PageSize + 1;}
                            @foreach (var u in Model.Items)
                            {
                                <tr>
                                    <td class="text-center text-muted small">@(stt++)</td>
                                    <td>
                                        <strong>@u.UserName</strong>
                                        @if (u.Id == meId)
                                        {
                                            <span class="badge badge-primary ml-1" style="font-size:10px;">Bạn</span>
                                        }
                                    </td>
                                    <td>@u.FullName</td>
                                    <td class="text-muted small">@u.Email</td>
                                    <td class="text-muted small">@(u.DeptName ?? "—")</td>
                                    <td>
                                        @if (u.Roles.Count > 0)
                                        {
                                            @foreach (var role in u.Roles)
                                            {
                                                <span class="badge badge-light border mr-1" style="font-size:11px;">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (u.IsActive)
                                        {
                                            <span class="badge badge-success">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Vô hiệu</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pager" model="Model" />
            }
        </div>
    </div>
</div>
