@model CreateUserRequest
@{
    ViewData["Title"] = "Tạo người dùng";
    var depts = ViewBag.Depts as IEnumerable<DeptDto> ?? Enumerable.Empty<DeptDto>();
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="User">Người dùng</a></li>
    <li class="breadcrumb-item active">Tạo mới</li>
}
<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;background:var(--primary-light);color:var(--primary);border-radius:8px;"><i class="fas fa-user-plus"></i></div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Tạo người dùng</h6>
                    <div class="text-muted small">Tài khoản đăng nhập và thông tin cơ bản.</div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-figma">
        <div class="card-content-figma">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="UserName" class="label-figma"></label>
                        <input asp-for="UserName" class="form-control" />
                    </div>
                    <div class="form-group col-md-6">
                        <label asp-for="Email" class="label-figma"></label>
                        <input asp-for="Email" class="form-control" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="FullName" class="label-figma"></label>
                        <input asp-for="FullName" class="form-control" />
                    </div>
                    <div class="form-group col-md-6">
                        <label asp-for="Password" class="label-figma"></label>
                        <input asp-for="Password" type="password" class="form-control" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="DeptId" class="label-figma"></label>
                        <select asp-for="DeptId" class="form-control">
                            <option value="0">—</option>
                            @foreach (var d in depts)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label asp-for="PositionId" class="label-figma"></label>
                        <input asp-for="PositionId" class="form-control" />
                    </div>
                </div>
                <div class="form-group-figma">
                    <label asp-for="Phone" class="label-figma"></label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <div class="custom-control custom-checkbox mb-3">
                    <input asp-for="IsAdmin" class="custom-control-input" id="userIsAdmin" />
                    <label asp-for="IsAdmin" class="custom-control-label" for="userIsAdmin"></label>
                </div>
                <div class="d-flex flex-wrap" style="gap:8px;">
                    <button type="submit" class="btn-figma btn-figma-primary">Lưu</button>
                    <a asp-action="Index" class="btn-figma btn-figma-outline">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
