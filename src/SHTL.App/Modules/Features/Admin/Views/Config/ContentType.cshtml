@model IEnumerable<ContentTypeDto>
@{ ViewData["Title"] = "Content Type"; }
@section Breadcrumb { <li class="breadcrumb-item"><a asp-area="admin" asp-controller="Home" asp-action="Index">Tổng quan</a></li><li class="breadcrumb-item"><a asp-area="admin" asp-controller="Config" asp-action="Index">Cấu hình thông số</a></li><li class="breadcrumb-item active">Loại nội dung</li> }
<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;background:var(--primary-light);color:var(--primary);border-radius:8px;"><i class="fas fa-layer-group"></i></div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Content Type</h6>
                    <div class="text-muted small">Cấu hình nhóm nội dung (đọc)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="frame-figma frame-figma-combined">
        <div class="p-3">
            @Html.AntiForgeryToken()
            <div class="table-container-figma">
                <table class="table table-sm table-figma mb-0">
                    <thead><tr><th>Id</th><th>Tên</th><th>Mã</th></tr></thead>
                    <tbody>@foreach (var x in Model) { <tr><td>@x.Id</td><td>@x.Name</td><td><code>@x.Code</code></td></tr> }</tbody>
                </table>
            </div>
            <p class="small text-muted mb-0 mt-3">Lưu qua API SaveContentType — bổ sung form khi cần.</p>
        </div>
    </div>
</div>
