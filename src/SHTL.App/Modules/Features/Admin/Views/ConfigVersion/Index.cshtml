@{ ViewData["Title"] = "Phiên bản cấu hình"; }
@section Breadcrumb { <li class="breadcrumb-item"><a asp-area="admin" asp-controller="Home" asp-action="Index">Tổng quan</a></li><li class="breadcrumb-item active">Phiên bản cấu hình</li> }
<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;background:var(--primary-light);color:var(--primary);border-radius:8px;"><i class="fas fa-file-archive"></i></div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Phiên bản cấu hình</h6>
                    <div class="text-muted small">Import / export ZIP (theo kế hoạch module)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-figma">
        <div class="card-content-figma py-4">
            <p class="text-muted mb-0">Màn hình placeholder — liên kết từ menu Admin. Sẽ bổ sung thao tác import/export khi triển khai.</p>
        </div>
    </div>
</div>
