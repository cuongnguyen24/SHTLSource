@model IEnumerable<RoleDto>
@{
    ViewData["Title"] = "Vai trò";
}
@section Breadcrumb { <li class="breadcrumb-item"><a asp-area="admin" asp-controller="Home" asp-action="Index">Tổng quan</a></li><li class="breadcrumb-item active">Vai trò</li> }
<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Vai trò &amp; nhóm quyền</h6>
            <span class="text-muted small">Danh sách vai trò có sẵn trong hệ thống — chỉ được phép sửa, không tạo mới hay xoá.</span>
        </div>
    </div>
    <div class="frame-figma p-0">
        @if (!Model.Any())
        {
            <div class="alert alert-light border m-3 mb-0">Chưa có vai trò.</div>
        }
        else
        {
            <div class="table-container-figma mb-0">
                <table class="table table-sm table-figma mb-0">
                    <thead>
                        <tr>
                            <th style="width:60px;">ID</th>
                            <th>Tên vai trò</th>
                            <th style="width:220px;">Mã</th>
                            <th>Mô tả</th>
                            <th style="width:100px;" class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Id</td>
                            <td><strong>@r.Name</strong></td>
                            <td><code>@r.Code</code></td>
                            <td class="text-muted small">@(string.IsNullOrWhiteSpace(r.Description) ? "—" : r.Description)</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@r.Id"
                                   class="btn-figma btn-figma-outline btn-sm"
                                   title="Sửa vai trò">
                                    <i class="fas fa-edit mr-1"></i>Sửa
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
