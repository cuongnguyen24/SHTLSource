{
  "Authentication": {
    "CookieName": ".Shtl.Auth"
  },
  "Shell": {
    "ProductTitle": "SHTL - Số hóa",
    "BrandShort": "SHTL",
    "Hotline": "",
    "AdminUrl": "/admin",
    "SoHoaUrl": "/sohoa",
    "UploaderUrl": "/sohoa/dong-bo-upload",
    "AccountUrl": "/account",
    "ProfilePath": "/Profile",
    "ExternalLoginUrl": "/account/Account/Login",
    "ExternalLogoutUrl": "/account/Account/Logout"
  },
  "Storage": {
    "RootPath": "E:\\SHTL\\Files",
    "VirtualPath": "/files",
    "ThumbnailPath": "E:\\SHTL\\Thumbs",
    "MaxFileSizeBytes": 9223372036854775807
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "IndexPrefix": "shtl"
  },
  "Uploader": {
    "ApiKey": "change_me",
    "AllowAnonymousUpload": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AccessLogging": {
    "Enabled": true
  },
  "AllowedHosts": "*",
  "PluginLocalPort": 81
  ,
  "PluginSync": {
    "Enabled": true,
    "LaunchUrl": "http://127.0.0.1:18181/activate",
    "HealthUrl": "http://127.0.0.1:18181/health",
    "HealthTimeoutMs": 1500
  }
}
