@model PaginatedResult<DocumentDto>
@using SHTL.Modules.Core.Domain.Enums
@{
    ViewData["Title"] = "Kiểm tra scan lần 1";
    var search = ViewBag.Search as string ?? "";
    string StepVi(WorkflowStep s) => s switch
    {
        WorkflowStep.Scan => "Upload / Scan",
        WorkflowStep.CheckScan1 => "Chờ kiểm tra lần 1",
        WorkflowStep.CheckScan2 => "Chờ kiểm tra lần 2",
        WorkflowStep.Extract => "Nhập liệu",
        WorkflowStep.Zone => "Khoanh vùng",
        _ => s.ToString()
    };
    string TrangThaiScan1(DocumentDto d)
    {
        if (d.CurrentStep is WorkflowStep.Scan or WorkflowStep.CheckScan1)
            return "Chờ kiểm tra";
        return "Đã kiểm tra";
    }
    var sttBase = (Model.PageIndex - 1) * Model.PageSize;
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-area="sohoa" asp-controller="Home" asp-action="Index">Tổng quan</a></li>
    <li class="breadcrumb-item"><a asp-area="sohoa" asp-controller="Scan" asp-action="Index">Scan / Upload</a></li>
    <li class="breadcrumb-item active">Kiểm tra scan 1</li>
}
@section Styles {
    <style>
        .action-btn { padding: 4px 8px; margin: 0 2px; font-size: 12px; }
        .action-btn i { margin-right: 0; }
    </style>
}

<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:var(--primary-light);color:var(--primary);border-radius:6px;"><i class="fas fa-check"></i></div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Kiểm tra scan lần 1</h6>
                    <div class="text-muted small">Mở <strong class="text-dark">Xem PDF</strong> từ cột thao tác, đối chiếu file rồi bấm <strong class="text-dark">Đạt / Từ chối</strong> trên trang PDF. Bản <strong>đã kiểm tra scan 1</strong> vẫn hiển thị (cột Trạng thái). <span class="text-success">Đạt</span> chuyển bước kế; <span class="text-danger">Từ chối</span> trả về bước scan.</div>
                </div>
            </div>
            <a asp-area="sohoa" asp-controller="Scan" asp-action="Index" class="btn-figma btn-figma-secondary btn-sm">Danh sách upload</a>
        </div>
    </div>

    <div class="frame-figma frame-figma-combined">
        <div class="frame-filter">
            <form method="get" class="d-flex align-items-center flex-wrap" style="gap:8px;">
                <div class="search-input-figma" style="min-width:260px;">
                    <input type="text" name="q" value="@search" placeholder="Tìm theo tên, ký hiệu, số hồ sơ…" />
                    <i class="fas fa-search search-icon"></i>
                </div>
                <input type="hidden" name="size" value="@Model.PageSize" />
                <button type="submit" class="btn-figma btn-figma-primary">Tìm kiếm</button>
            </form>
        </div>
        <div class="p-3">
            @if (!Model.Items.Any())
            {
                <div class="alert alert-light border mb-0">
                    <p class="mb-2"><strong>Chưa có tài liệu trong hàng đợi kiểm tra lần 1.</strong> Hàng đợi gồm bản ghi đang ở bước <em>Scan / Upload</em> (vừa tải lên) hoặc bước <em>Kiểm tra scan 1</em> (ví dụ trả từ scan 2).</p>
                    <p class="mb-2 small text-muted">Sau khi upload/đồng bộ, nếu <code>IsCheckFirstScan</code> bật (mặc định bật), hệ thống đặt bước <strong>Kiểm tra scan 1</strong> luôn. Nếu tắt kiểm tra scan, tài liệu vào thẳng bước nhập liệu và sẽ <strong>không</strong> hiện ở đây.</p>
                    <p class="mb-0 small text-muted">Khi đã có hàng đợi: mở biểu tượng PDF từng dòng và xác nhận trên trang xem file.</p>
                    <p class="mb-0 mt-2"><a asp-area="sohoa" asp-controller="Scan" asp-action="Index" class="btn-figma btn-figma-outline btn-sm">Mở danh sách upload</a></p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead class="table-light">
                            <tr>
                                <th style="width:48px;">STT</th>
                                <th style="width:72px;">ID</th>
                                <th>Tên / file</th>
                                <th style="min-width:120px;">Loại TL</th>
                                <th style="width:130px;">Trạng thái</th>
                                <th style="width:140px;">Bước</th>
                                <th style="width:72px;" class="text-center">Trang</th>
                                <th style="width:130px;">Tạo</th>
                                <th style="width:110px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var i = 0;
                                foreach (var d in Model.Items)
                                {
                                    i++;
                                    var stt = sttBase + i;
                                    <tr>
                                        <td class="text-center">@stt</td>
                                        <td><small class="text-muted">@d.Id</small></td>
                                        <td><strong>@(string.IsNullOrWhiteSpace(d.Name) ? "—" : d.Name)</strong></td>
                                        <td><small class="text-muted">@(d.DocTypeName ?? "—")</small></td>
                                        <td>
                                            @if (TrangThaiScan1(d) == "Đã kiểm tra")
                                            {
                                                <span class="badge badge-success" style="font-weight:500;">Đã kiểm tra</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning text-dark" style="font-weight:500;">Chờ kiểm tra</span>
                                            }
                                        </td>
                                        <td><small>@StepVi(d.CurrentStep)</small></td>
                                        <td class="text-center">@d.PageCount</td>
                                        <td><small class="text-muted">@d.Created.ToString("dd/MM/yyyy HH:mm")</small></td>
                                        <td>
                                            <a asp-area="sohoa" asp-controller="Scan" asp-action="Preview" asp-route-id="@d.Id" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary action-btn" title="Xem PDF — xác nhận kiểm tra trên trang này"><i class="fas fa-file-pdf"></i></a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            <partial name="_Pager" model="Model" />
        </div>
    </div>
</div>
