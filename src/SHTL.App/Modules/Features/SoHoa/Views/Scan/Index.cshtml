@model PaginatedResult<DocumentDto>
@using SHTL.Modules.Shared.Contracts
@{
    ViewData["Title"] = "Scan / Upload";
    var req = ViewBag.Request as DocumentFilterRequest ?? new DocumentFilterRequest();
    var docTypes = Model.Items
        .Where(x => x.DocTypeId > 0)
        .GroupBy(x => new { x.DocTypeId, Name = x.DocTypeName ?? $"Loại {x.DocTypeId}" })
        .Select(g => g.Key)
        .OrderBy(x => x.Name)
        .ToList();
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-area="sohoa" asp-controller="Home" asp-action="Index">Tổng quan</a></li>
    <li class="breadcrumb-item active">Scan / Upload</li>
}
@section Styles {
    <style>
        .scan-table tbody tr:hover { background-color: #f9f9f9; }
        .action-btn { padding: 4px 8px; margin: 0 2px; font-size: 12px; }
        .action-btn i { margin-right: 0; }
        .status-pill {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 11px;
            background: #f1f3f5;
            color: #6c757d;
            white-space: nowrap;
        }
    </style>
}

<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:var(--primary-light);color:var(--primary);border-radius:6px;"><i class="fas fa-upload"></i></div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Tài liệu vừa upload</h6>
                    <div class="text-muted small">Có @Model.TotalCount tài liệu được tìm thấy</div>
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center" style="gap:8px;">
                <a asp-area="sohoa" asp-controller="Scan" asp-action="CheckScan1List" class="btn-figma btn-figma-outline btn-sm">Kiểm tra scan 1</a>
                <a asp-area="sohoa" asp-controller="Scan" asp-action="CheckScan2List" class="btn-figma btn-figma-outline btn-sm">Kiểm tra scan 2</a>
                <a asp-area="sohoa" asp-controller="SyncUpload" asp-action="Index" class="btn-figma btn-figma-primary btn-sm"><i class="fas fa-cloud-upload-alt mr-1"></i>Đồng bộ</a>
            </div>
        </div>
    </div>

    <div class="frame-figma frame-figma-combined">
        <div class="frame-filter">
            <form method="get" class="d-flex align-items-end flex-wrap" style="gap:10px;">
                <div class="search-input-figma" style="min-width:220px;">
                    <label class="small text-muted mb-1 d-block">Từ khóa</label>
                    <input type="text" name="q" value="@req.Search" placeholder="Tên, ký hiệu…" />
                    <i class="fas fa-search search-icon"></i>
                </div>
                <div>
                    <label class="small text-muted mb-1 d-block">Từ ngày</label>
                    <input type="date" name="from" class="form-control form-control-sm" value="@(req.StartDate?.ToString("yyyy-MM-dd"))" style="min-width:140px;" />
                </div>
                <div>
                    <label class="small text-muted mb-1 d-block">Đến ngày</label>
                    <input type="date" name="to" class="form-control form-control-sm" value="@(req.EndDate?.ToString("yyyy-MM-dd"))" style="min-width:140px;" />
                </div>
                <div>
                    <label class="small text-muted mb-1 d-block">Loại tài liệu</label>
                    <select name="docTypeId" class="form-control form-control-sm" style="min-width:170px;">
                        <option value="">Tất cả</option>
                        @foreach (var dt in docTypes)
                        {
                            <option value="@dt.DocTypeId" selected="@(req.DocTypeId == dt.DocTypeId)">@dt.Name</option>
                        }
                    </select>
                </div>
                <input type="hidden" name="size" value="@Model.PageSize" />
                <button type="submit" class="btn-figma btn-figma-primary">Lọc</button>
            </form>
        </div>
        <div class="p-3">
            @if (!Model.Items.Any())
            {
                <div class="alert alert-light border mb-0">Không có tài liệu.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover scan-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px;">STT</th>
                                <th style="width:40px;"><input type="checkbox" id="selectAll" /></th>
                                <th>Đường dẫn</th>
                                <th>Tên</th>
                                <th>Loại tài liệu</th>
                                <th style="width:70px;">DPI</th>
                                <th style="width:70px;">Số trang</th>
                                <th style="width:120px;">Trạng thái</th>
                                <th style="width:180px;">Đánh giá kết quả</th>
                                <th style="width:150px;">Ngày thực hiện</th>
                                <th style="width:120px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var stt = ((Model.PageIndex - 1) * Model.PageSize) + 1;
                                foreach (var d in Model.Items)
                                {
                                    var eval = d.IsCheckedScan2 ? "Đã kiểm tra 2" : d.IsCheckedScan1 ? "Đã kiểm tra 1" : "Chưa đánh giá";
                                    var evalAt = d.Checked2At ?? d.Checked1At;
                                    <tr>
                                        <td class="text-center">@stt</td>
                                        <td class="text-center"><input type="checkbox" class="row-check" value="@d.Id" /></td>
                                        <td><small>@(d.FilePath ?? d.FileName ?? "—")</small></td>
                                        <td>
                                            <div><strong>@d.Name</strong></div>
                                            <small class="text-muted">@d.Created.ToString("dd/MM/yyyy HH:mm")</small><br />
                                            <small class="text-muted">@((d.FileName ?? "—"))</small>
                                        </td>
                                        <td><small>@(d.DocTypeName ?? "—")</small></td>
                                        <td class="text-center">@(d.MinDpi > 0 ? Math.Round(d.MinDpi).ToString("0") : "—")</td>
                                        <td class="text-center">@d.PageCount</td>
                                        <td>
                                            <span class="status-pill">@d.CurrentStepName</span>
                                            @if (SearchablePdfDisplay.LooksLikePdf(d.Extension, d.FileName, d.FilePath) && !string.IsNullOrEmpty(d.SearchablePdfStatusText))
                                            {
                                                <br /><span class="status-pill" style="background:#e7f5ff;color:#1864ab;">@d.SearchablePdfStatusText</span>
                                            }
                                        </td>
                                        <td><small>@eval</small></td>
                                        <td><small>@(evalAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</small></td>
                                        <td>
                                            <a asp-area="sohoa" asp-controller="Scan" asp-action="Detail" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary action-btn"><i class="fas fa-info-circle"></i></a>
                                            <a asp-area="sohoa" asp-controller="Scan" asp-action="Preview" asp-route-id="@d.Id" class="btn btn-sm btn-outline-warning action-btn"><i class="fas fa-file-pdf"></i></a>
                                            <button type="button" class="btn btn-sm btn-outline-danger action-btn btn-delete" data-id="@d.Id"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                    stt++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pager" model="Model" />
            }
        </div>
    </div>
</div>

<form id="antiScan" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        (function () {
            var deleteUrl = '@Url.Content("~/scan/delete")';
            var selectAll = document.getElementById('selectAll');
            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    document.querySelectorAll('.row-check').forEach(function (cb) { cb.checked = selectAll.checked; });
                });
            }

            document.querySelectorAll('.btn-delete').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.getAttribute('data-id');
                    if (!id) return;
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ title: 'Xóa tài liệu?', text: 'ID ' + id, icon: 'warning', showCancelButton: true, confirmButtonText: 'Xóa', cancelButtonText: 'Hủy' })
                            .then(function (r) { if (r.isConfirmed) doDelete(id); });
                    } else if (confirm('Xóa tài liệu #' + id + '?')) {
                        doDelete(id);
                    }
                });
            });

            function token() {
                var i = document.querySelector('#antiScan input[name="__RequestVerificationToken"]');
                return i ? i.value : '';
            }
            function doDelete(id) {
                var fd = new FormData();
                fd.append('id', String(id));
                fd.append('__RequestVerificationToken', token());
                fetch(deleteUrl, { method: 'POST', body: fd, credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (j) {
                        if (j.success) {
                            if (typeof toastr !== 'undefined') toastr.success(j.message || 'Đã xóa');
                            window.location.reload();
                        } else {
                            if (typeof toastr !== 'undefined') toastr.error(j.message || 'Không xóa được');
                            else alert(j.message || 'Lỗi');
                        }
                    })
                    .catch(function () { if (typeof toastr !== 'undefined') toastr.error('Lỗi mạng'); });
            }
        })();
    </script>
}
