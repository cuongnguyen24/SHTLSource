@{
    ViewData["Title"] = "Tổng quan số hóa";
}
@section Breadcrumb {
    <li class="breadcrumb-item active">Tổng quan</li>
}

<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:var(--primary-light);color:var(--primary);border-radius:6px;">
                    <i class="fas fa-digital-tachograph"></i>
                </div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);font-size:15px;">Số hóa tài liệu</h6>
                    <div class="text-muted" style="font-size:11px;">Chọn chức năng từ menu trái hoặc lối tắt bên dưới.</div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 col-sm-6 mb-3"><a class="card card-body shadow-sm h-100 text-decoration-none frame-figma" asp-area="sohoa" asp-controller="Scan" asp-action="Index"><i class="fas fa-upload text-primary mb-2"></i><div class="font-weight-bold text-dark">Scan / Upload</div></a></div>
        <div class="col-md-4 col-sm-6 mb-3"><a class="card card-body shadow-sm h-100 text-decoration-none frame-figma" asp-area="sohoa" asp-controller="Extract" asp-action="Index"><i class="fas fa-keyboard text-primary mb-2"></i><div class="font-weight-bold text-dark">Nhập liệu</div></a></div>
        <div class="col-md-4 col-sm-6 mb-3"><a class="card card-body shadow-sm h-100 text-decoration-none frame-figma" asp-area="sohoa" asp-controller="Export" asp-action="Index"><i class="fas fa-file-export text-primary mb-2"></i><div class="font-weight-bold text-dark">Export</div></a></div>
        <div class="col-md-4 col-sm-6 mb-3"><a class="card card-body shadow-sm h-100 text-decoration-none frame-figma" asp-area="sohoa" asp-controller="LoaiTaiLieu" asp-action="Index"><i class="fas fa-tags text-primary mb-2"></i><div class="font-weight-bold text-dark">Loại tài liệu</div></a></div>
        <div class="col-md-4 col-sm-6 mb-3"><a class="card card-body shadow-sm h-100 text-decoration-none frame-figma" asp-area="sohoa" asp-controller="LoaiDongBo" asp-action="Index"><i class="fas fa-sync-alt text-primary mb-2"></i><div class="font-weight-bold text-dark">Loại đồng bộ</div></a></div>
        <div class="col-md-4 col-sm-6 mb-3"><a class="card card-body shadow-sm h-100 text-decoration-none frame-figma" asp-area="sohoa" asp-controller="Report" asp-action="FolderProgress"><i class="fas fa-chart-line text-primary mb-2"></i><div class="font-weight-bold text-dark">Tiến độ theo thư mục</div></a></div>
        <div class="col-md-4 col-sm-6 mb-3"><a class="card card-body shadow-sm h-100 text-decoration-none frame-figma" asp-area="sohoa" asp-controller="Home" asp-action="SpeechDemo"><i class="fas fa-microphone text-primary mb-2"></i><div class="font-weight-bold text-dark">Demo giọng nói</div></a></div>
    </div>
</div>
