@model PaginatedResult<DocumentDto>
@using SHTL.Modules.Core.Domain.Enums
@using SHTL.Modules.Shared.Contracts
@using SHTL.Modules.Shared.Contracts.Dtos
@{
    ViewData["Title"] = "Nhập liệu (Extract)";
    var req = ViewBag.Request as DocumentFilterRequest ?? new DocumentFilterRequest { Step = WorkflowStep.Extract };
    var q = Context.Request.Query["q"].FirstOrDefault() ?? string.Empty;
    var requireCheckFirstScan = (bool?)ViewBag.RequireCheckFirstScan ?? true;
    var requireCheckSecondScan = (bool?)ViewBag.RequireCheckSecondScan ?? true;
    var docTypes = Model.Items
        .Where(x => x.DocTypeId > 0)
        .GroupBy(x => new { x.DocTypeId, Name = x.DocTypeName ?? $"Loại {x.DocTypeId}" })
        .Select(g => new { g.Key.DocTypeId, g.Key.Name })
        .OrderBy(x => x.Name)
        .ToList();
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-area="sohoa" asp-controller="Home" asp-action="Index">Tổng quan</a></li>
    <li class="breadcrumb-item active">Nhập liệu</li>
}
@section Styles {
    <style>
        .extract-table tbody tr:hover { background-color: #f9f9f9; cursor: pointer; }
        .extract-table tbody tr.is-selected { background-color: #eef6ff; }
        .extract-filter-grid {
            display: grid;
            grid-template-columns: minmax(280px, 1.6fr) minmax(220px, 1fr) minmax(220px, 1fr) auto;
            gap: 10px;
            align-items: end;
        }
        .extract-filter-item label { margin-bottom: 6px; }
        .extract-filter-item .extract-search-wrap input,
        .extract-filter-item .form-control {
            height: 38px;
        }
        .extract-filter-item .extract-search-wrap {
            width: 100%;
            min-width: 0;
            position: relative;
        }
        .extract-filter-item .extract-search-wrap input {
            width: 100%;
            border: 1px solid #ced4da;
            border-radius: 8px;
            padding: 0 38px 0 12px;
            line-height: 38px;
            background: #fff;
        }
        .extract-filter-item .extract-search-wrap .search-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
            pointer-events: none;
        }
        @@media (max-width: 1200px) {
            .extract-filter-grid { grid-template-columns: 1fr 1fr; }
        }
        @@media (max-width: 768px) {
            .extract-filter-grid { grid-template-columns: 1fr; }
        }
        .status-pill {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 11px;
            background: #f1f3f5;
            color: #6c757d;
            white-space: nowrap;
        }
    </style>
}

<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:var(--primary-light);color:var(--primary);border-radius:6px;"><i class="fas fa-keyboard"></i></div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Hàng chờ nhập liệu</h6>
                    <div class="text-muted small">Tìm theo tên/đường dẫn; lọc theo loại tài liệu và trạng thái nhập liệu.</div>
                </div>
            </div>
            <div class="d-flex flex-wrap" style="gap:8px;">
                <a asp-area="sohoa" asp-controller="Extract" asp-action="Take" class="btn-figma btn-figma-primary btn-sm"><i class="fas fa-bolt mr-1"></i>Nhận nhanh 1 bản</a>
                <button type="button" class="btn-figma btn-figma-outline btn-sm" id="btnOpenForm" disabled><i class="fas fa-edit mr-1"></i>Mở form</button>
            </div>
        </div>
    </div>

    <div class="frame-figma frame-figma-combined">
        <div class="frame-filter">
            <form method="get" class="extract-filter-grid">
                <div class="extract-filter-item">
                    <label class="small text-muted d-block">Từ khóa</label>
                    <div class="extract-search-wrap">
                        <input type="text" name="q" value="@q" placeholder="Tên, đường dẫn" />
                        <i class="fas fa-search search-icon"></i>
                    </div>
                </div>
                <div class="extract-filter-item">
                    <label class="small text-muted d-block">Loại tài liệu</label>
                    <select name="docTypeId" class="form-control form-control-sm">
                        <option value="">Tất cả loại tài liệu</option>
                        @foreach (var dt in docTypes)
                        {
                            if (req.DocTypeId == dt.DocTypeId)
                            { <option value="@dt.DocTypeId" selected="selected">@dt.Name</option> }
                            else
                            { <option value="@dt.DocTypeId">@dt.Name</option> }
                        }
                    </select>
                </div>
                <div class="extract-filter-item">
                    <label class="small text-muted d-block">Trạng thái</label>
                    <select name="status" class="form-control form-control-sm">
                        @if (req.ExtractInputStatus is null)
                        { <option value="" selected="selected">Tất cả trạng thái</option> }
                        else
                        { <option value="">Tất cả trạng thái</option> }
                        @if (req.ExtractInputStatus == 1)
                        { <option value="1" selected="selected">Chưa đủ điều kiện</option> }
                        else
                        { <option value="1">Chưa đủ điều kiện</option> }
                        @if (req.ExtractInputStatus == 2)
                        { <option value="2" selected="selected">Chưa nhập</option> }
                        else
                        { <option value="2">Chưa nhập</option> }
                        @if (req.ExtractInputStatus == 3)
                        { <option value="3" selected="selected">Đã nhập</option> }
                        else
                        { <option value="3">Đã nhập</option> }
                    </select>
                </div>
                <input type="hidden" name="size" value="@Model.PageSize" />
                <button type="submit" class="btn-figma btn-figma-primary">Tìm kiếm</button>
            </form>
        </div>
        <div class="p-3">
            @if (!Model.Items.Any())
            {
                <div class="alert alert-light border mb-0">Không có bản ghi.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover extract-table mb-0" id="extractTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px;">STT</th>
                                <th style="min-width:220px;">Đường dẫn</th>
                                <th>Tên</th>
                                <th>Loại tài liệu</th>
                                <th style="width:140px;">Trạng thái nhập</th>
                                <th style="width:100px;">Số lần trả về</th>
                                <th style="min-width:200px;">Lý do từ chối (check 1)</th>
                                <th style="width:180px;">Đánh giá kết quả thực hiện</th>
                                <th style="width:140px;">Ngày nhập</th>
                                <th style="width:120px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var stt = ((Model.PageIndex - 1) * Model.PageSize) + 1;
                                foreach (var d in Model.Items)
                                {
                                    var inputStatus = ((requireCheckFirstScan && !d.IsCheckedScan1) || (requireCheckSecondScan && !d.IsCheckedScan2))
                                        ? "Chưa đủ điều kiện"
                                        : (d.IsExtracted ? "Đã nhập" : "Chưa nhập");
                                    var checkEval = d.Checked1At.HasValue
                                        ? (d.Checked1Result == StepResult.Pass
                                            ? "Đạt"
                                            : (d.Checked1Result == StepResult.Return
                                                ? "Trả về"
                                                : (d.Checked1Result == StepResult.Fail ? "Lỗi" : "Chưa đánh giá")))
                                        : "Chưa đánh giá";
                                    var rowClass = inputStatus == "Chưa đủ điều kiện" ? "status-pill text-white bg-secondary" :
                                                   inputStatus == "Đã nhập" ? "status-pill text-white bg-success" :
                                                   "status-pill";
                                    var hasReject = !string.IsNullOrWhiteSpace(d.Checked1ReturnReason);
                                    var reasonShort = hasReject && d.Checked1ReturnReason!.Length > 120
                                        ? d.Checked1ReturnReason[..120] + "…"
                                        : d.Checked1ReturnReason;
                                    var check1PassedViewOnly = d.IsChecked1 || d.Checked1Result == StepResult.Pass;
                                    <tr data-id="@d.Id" class="@(hasReject ? "table-warning" : null)">
                                        <td class="text-center">@stt</td>
                                        <td><small>@(string.IsNullOrWhiteSpace(d.FilePath) ? "—" : d.FilePath)</small></td>
                                        <td>
                                            <div><strong>@d.Name</strong></div>
                                            <small class="text-muted">@((d.FileName ?? "—"))</small>
                                        </td>
                                        <td><small>@(d.DocTypeName ?? "—")</small></td>
                                        <td><span class="@rowClass">@inputStatus</span></td>
                                        <td class="text-center">@d.Checked1ReturnCount</td>
                                        <td>
                                            @if (hasReject)
                                            {
                                                <small class="text-dark font-weight-bold" title="@d.Checked1ReturnReason">@reasonShort</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">—</small>
                                            }
                                        </td>
                                        <td><small>@checkEval</small></td>
                                        <td><small>@(d.ExtractedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</small></td>
                                        <td>
                                            @if (check1PassedViewOnly)
                                            {
                                                <a asp-area="sohoa" asp-controller="Extract" asp-action="Form" asp-route-id="@d.Id"
                                                   class="btn btn-sm btn-outline-secondary" title="Chỉ xem (đã đạt kiểm tra lần 1)">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-area="sohoa" asp-controller="Extract" asp-action="Form" asp-route-id="@d.Id"
                                                   class="btn btn-sm btn-outline-primary" title="Nhập / sửa liệu">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                    stt++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pager" model="Model" />
                <p class="text-muted small mt-2 mb-0">Chọn dòng rồi bấm <strong>Mở form</strong> hoặc double-click để mở nhanh.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var selId = null;
            var table = document.getElementById('extractTable');
            var openFormUrlTemplate = '@Url.Action("Form", "Extract", new { area = "sohoa", id = "__ID__" })';
            function syncBtn() {
                document.getElementById('btnOpenForm').disabled = !(selId && selId > 0);
            }

            if (table) {
                table.querySelectorAll('tbody tr[data-id]').forEach(function (row) {
                    row.addEventListener('click', function () {
                        table.querySelectorAll('tbody tr.is-selected').forEach(function (selected) {
                            selected.classList.remove('is-selected');
                        });
                        row.classList.add('is-selected');
                        var id = parseInt(row.getAttribute('data-id'), 10);
                        selId = id > 0 ? id : null;
                        syncBtn();
                    });

                    row.addEventListener('dblclick', function () {
                        var id = parseInt(row.getAttribute('data-id'), 10);
                        if (id > 0) window.location.href = openFormUrlTemplate.replace('__ID__', String(id));
                    });
                });
            }

            document.getElementById('btnOpenForm').onclick = function () {
                if (selId) window.location.href = openFormUrlTemplate.replace('__ID__', String(selId));
            };
        })();
    </script>
}
