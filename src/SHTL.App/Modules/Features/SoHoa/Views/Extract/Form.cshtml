@model DocumentFormViewModel
@using System.Text.Json
@using SHTL.Modules.Core.Domain.Enums
@using SHTL.Modules.Shared.Contracts
@using SHTL.Modules.Shared.Contracts.ViewModels
@{
    var doc = Model.Document!;
    var extractReadOnlyAfterCheck1Pass = doc.IsChecked1 || doc.Checked1Result == StepResult.Pass;
    ViewData["ExtractFormReadOnly"] = extractReadOnlyAfterCheck1Pass;
    ViewData["Title"] = extractReadOnlyAfterCheck1Pass ? ("Xem nhập liệu — " + doc.Name) : ("Nhập liệu — " + doc.Name);
    var submitUrl = Url.Action("Submit", "Extract", new { area = "sohoa" })!;
    var applyOcrZonesUrl = Url.Action("ApplyOcrZones", "Extract", new { area = "sohoa", id = doc.Id })!;
    var ocrTemporaryZoneUrl = Url.Action("OcrTemporaryZone", "Extract", new { area = "sohoa", id = doc.Id })!;
    var previewUrl = Url.Content("~/scan/preview/" + doc.Id);
    var indexUrl = Url.Action("Index", "Extract", new { area = "sohoa" })!;
    var pdfRawUrl = Url.Content("~/scan/pdf/" + doc.Id) + "?ocr=" + ((int)doc.OcrStatus).ToString() + "&v=" + Uri.EscapeDataString(doc.PathPdfSearchable ?? doc.FilePath ?? "");
    var pdfViewerUrl = Url.Content("~/sohoa-assets/pdf/viewer.html") + "?file=" + Uri.EscapeDataString(pdfRawUrl);
    var compatibilityJsUrl = Url.Content("~/sohoa-assets/pdf/compatibility.js");
    var pdfJsUrl = Url.Content("~/sohoa-assets/pdf/build/pdf.js");
    var pdfWorkerUrl = Url.Content("~/sohoa-assets/pdf/build/pdf.worker.js");
    var showPdfViewer = SearchablePdfDisplay.LooksLikePdf(doc.Extension, doc.FileName, doc.FilePath);
    var spLabel = doc.SearchablePdfStatusText;

    string? Fv(FieldSettingViewModel f)
    {
        if (!string.IsNullOrWhiteSpace(f.PostFieldKey) && Model.FieldValues.TryGetValue(f.PostFieldKey, out var postValue))
            return postValue;

        if (!string.IsNullOrWhiteSpace(f.FieldName) && Model.FieldValues.TryGetValue(f.FieldName, out var x))
            return x;

        // Fallback by FieldId for legacy settings where FieldName is missing/misaligned.
        string[] keys = f.FieldId switch
        {
            1 => new[] { "dc_title", "name" },
            2 => new[] { "dc_symbol", "symbol_no", "symbolno" },
            3 => new[] { "issuer", "dc_issued_by", "issued_by", "issuedby" },
            4 => new[] { "receiver", "dc_receiver" },
            5 => new[] { "subject", "describe" },
            6 => new[] { "levelno", "dc_box", "level_no" },
            7 => new[] { "boxno", "dc_num1", "box_no", "hop_so" },
            8 => new[] { "recordno", "dc_record", "record_no", "ho_so_so" },
            9 => new[] { "recordtitle", "fc_title", "record_title" },
            10 => new[] { "poster", "author" },
            11 => new[] { "signer" },
            12 => new[] { "slotno", "slot_no" },
            13 => new[] { "shelfno", "shelf_no" },
            14 => new[] { "noted", "dc_noted" },
            15 => new[] { "fc_dec1", "field23" },
            16 => new[] { "fc_date1", "field22" },
            17 => new[] { "std_text", "field15" },
            18 => new[] { "std_num", "field16" },
            19 => new[] { "std_dec", "field23" },
            20 => new[] { "std_date", "field21" },
            >= 101 and <= 125 => new[] { $"field{f.FieldId - 100}" },
            _ => Array.Empty<string>()
        };
        foreach (var key in keys)
        {
            if (Model.FieldValues.TryGetValue(key, out var mapped) && !string.IsNullOrWhiteSpace(mapped))
                return mapped;
        }

        // Preserve title behavior from physical file_name.
        if (f.FieldId == 1)
            return !string.IsNullOrWhiteSpace(doc.FileName) ? doc.FileName : doc.Name;

        return f.FixValue;
    }

    var orderedFields = Model.FieldSettings.OrderBy(f => f.Weight).ToList();
    var cells = Model.Cells.OrderBy(c => c.Page).ThenBy(c => c.Y).ThenBy(c => c.X).ToList();
    var sameRecordDocs = Model.SameRecordDocuments ?? Array.Empty<DocumentDto>();

    string GroupNameOf(int groupId)
    {
        if (!Model.FieldGroups.TryGetValue(groupId, out var g)) return string.Empty;
        return string.IsNullOrEmpty(g.GroupName) ? g.Name : (g.GroupName ?? string.Empty);
    }
    bool IsDocInfoField(FieldSettingViewModel f) => string.Equals(GroupNameOf(f.GroupId), "Thông tin tài liệu", StringComparison.Ordinal);
    bool IsRecordInfoField(FieldSettingViewModel f) => string.Equals(GroupNameOf(f.GroupId), "Thông tin hồ sơ", StringComparison.Ordinal);

    var docInfoFields = orderedFields.Where(IsDocInfoField).ToList();
    var recordInfoFields = orderedFields.Where(IsRecordInfoField).ToList();
    var otherFields = orderedFields.Where(f => !IsDocInfoField(f) && !IsRecordInfoField(f)).ToList();
    var hasOtherTab = otherFields.Count > 0 || cells.Count > 0;
    var requireCheckFirstScan = (bool?)ViewBag.RequireCheckFirstScan ?? true;
    var requireCheckSecondScan = (bool?)ViewBag.RequireCheckSecondScan ?? true;
    var scanOkForExtract = (!requireCheckFirstScan || doc.IsCheckedScan1) && (!requireCheckSecondScan || doc.IsCheckedScan2);
    var ocrZonesForClient = Model.OcrZones.Select(z => new
    {
        fieldSettingId = z.FieldSettingId,
        fieldId = z.FieldId,
        pageNumber = z.PageNumber,
        xRatio = z.XRatio,
        yRatio = z.YRatio,
        widthRatio = z.WidthRatio,
        heightRatio = z.HeightRatio,
        label = z.Label
    }).ToList();
    // Đã nhập nhưng chưa đạt check 1 (hoặc bị trả về) mới được sửa/lưu lại.
    var canReEditExtractBeforeCheck1 = doc.IsExtracted && !extractReadOnlyAfterCheck1Pass;
    var canSubmitExtract = !extractReadOnlyAfterCheck1Pass && (scanOkForExtract || canReEditExtractBeforeCheck1);
    string extractBlockedReason;
    if (extractReadOnlyAfterCheck1Pass)
        extractBlockedReason = "Đã đạt kiểm tra lần 1 — chỉ xem, không lưu nhập liệu.";
    else if (!canSubmitExtract)
        extractBlockedReason = $"Tài liệu chưa đủ điều kiện nhập liệu: {(requireCheckFirstScan && !doc.IsCheckedScan1 ? "Check scan 1" : string.Empty)}{(requireCheckFirstScan && !doc.IsCheckedScan1 && requireCheckSecondScan && !doc.IsCheckedScan2 ? ", " : string.Empty)}{(requireCheckSecondScan && !doc.IsCheckedScan2 ? "Check scan 2" : string.Empty)} chưa hoàn thành.";
    else
        extractBlockedReason = string.Empty;
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-area="sohoa" asp-controller="Home" asp-action="Index">Tổng quan</a></li>
    <li class="breadcrumb-item"><a asp-area="sohoa" asp-controller="Extract" asp-action="Index">Nhập liệu</a></li>
    <li class="breadcrumb-item active">#@doc.Id</li>
}
@section Styles {
    <style>
        .split-layout {
            display: flex;
            align-items: stretch;
            height: calc(100vh - 220px); /* fallback — JS sẽ ghi đè theo offset thật */
            min-height: 420px;
            overflow: hidden;
        }
        .split-pane-left {
            flex: 0 0 42%;
            min-width: 320px;
            max-width: 78%;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .split-pane-left > .card-figma {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }
        .split-pane-left .card-content-figma {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }
        .split-pane-left iframe {
            flex: 1 1 auto;
            min-height: 0;
            width: 100%;
            border: 0;
            display: block;
        }
        .extract-ocr-viewer {
            flex: 1 1 auto;
            min-height: 0;
            overflow: auto;
            background: #f8f9fa;
            position: relative;
        }
        .extract-pdf-native-frame {
            width: 100%;
            height: 100%;
            min-height: 520px;
            border: 0;
            display: block;
            background: #fff;
        }
        .extract-view-hidden {
            display: none !important;
        }
        .extract-ocr-page {
            position: relative;
            width: max-content;
            margin: 12px auto;
            background: #fff;
            box-shadow: 0 2px 12px rgba(0,0,0,.12);
        }
        .extract-ocr-page canvas {
            display: block;
        }
        .extract-pdf-text-layer {
            position: absolute;
            inset: 0;
            overflow: hidden;
            opacity: .01;
            line-height: 1;
            z-index: 1;
            user-select: text;
        }
        .extract-pdf-text-layer span {
            position: absolute;
            color: transparent;
            white-space: pre;
            transform-origin: 0 0;
            cursor: text;
        }
        .extract-ocr-zone-layer {
            position: absolute;
            inset: 0;
            z-index: 2;
            pointer-events: none;
        }
        .extract-ocr-zone {
            position: absolute;
            border: 3px solid #dc3545;
            background: rgba(220, 53, 69, .10);
            box-shadow: 0 0 18px rgba(220, 53, 69, .35);
            box-sizing: border-box;
            pointer-events: auto;
            cursor: move;
        }
        .extract-ocr-zone-label {
            position: absolute;
            left: -3px;
            top: -25px;
            max-width: 260px;
            padding: 2px 7px;
            border-radius: 4px;
            background: #dc3545;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .extract-ocr-handle {
            position: absolute;
            width: 12px;
            height: 12px;
            border: 2px solid #dc3545;
            background: #fff;
            border-radius: 50%;
            box-sizing: border-box;
        }
        .extract-ocr-handle-nw { left: -7px; top: -7px; cursor: nwse-resize; }
        .extract-ocr-handle-ne { right: -7px; top: -7px; cursor: nesw-resize; }
        .extract-ocr-handle-sw { left: -7px; bottom: -7px; cursor: nesw-resize; }
        .extract-ocr-handle-se { right: -7px; bottom: -7px; cursor: nwse-resize; }
        .extract-ocr-context {
            position: fixed;
            z-index: 1060;
            display: none;
            min-width: 150px;
            padding: 8px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 8px 24px rgba(0,0,0,.18);
        }
        .extract-pdf-toolbar {
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 6px 8px;
            border-bottom: 1px solid #dee2e6;
            background: #fff;
        }
        .split-pane-right {
            flex: 1 1 auto;
            min-width: 360px;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 4px;
        }
        .split-pane-right > .nav-tabs {
            position: sticky;
            top: 0;
            background: #fff;
            z-index: 2;
            margin: 0 0 12px;
            padding-top: 4px;
        }
        .splitter {
            width: 10px;
            cursor: col-resize;
            position: relative;
            user-select: none;
            flex: 0 0 auto;
        }
        .splitter::before {
            content: "";
            position: absolute;
            left: 4px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #dee2e6;
        }
        .splitter.is-dragging::before {
            background: var(--primary);
        }
        .ext-field-group.has-ocr-zone .form-control {
            border-color: #9ec5fe;
        }
        .ext-field-group.has-ocr-zone .form-control:focus,
        .ext-field-group.is-ocr-zone-active .form-control {
            border-color: #dc3545;
            box-shadow: 0 0 0 .2rem rgba(220, 53, 69, .15);
        }
        .ext-field-group.has-ocr-zone label::after {
            content: " OCR";
            display: inline-block;
            margin-left: 6px;
            padding: 1px 5px;
            border-radius: 999px;
            background: #e7f1ff;
            color: #0d6efd;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .02em;
        }
        @@media (max-width: 991.98px) {
            .split-layout {
                display: block;
                height: auto;
                min-height: auto;
                overflow: visible;
            }
            .split-pane-left,
            .split-pane-right {
                min-width: 0;
                max-width: none;
                width: 100%;
                overflow: visible;
                height: auto;
            }
            .split-pane-left iframe {
                height: 60vh;
                min-height: 420px;
            }
            .split-pane-right > .nav-tabs { position: static; }
            .splitter { display: none; }
        }
    </style>
}

<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div>
                <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">@doc.Name</h6>
                <div class="text-muted small">
                    Loại: @Model.DocType.Name · Bước hiện tại: @doc.CurrentStep
                    @if (!string.IsNullOrEmpty(spLabel))
                    {
                        <span class="badge badge-info ml-1">@spLabel</span>
                    }
                </div>
            </div>
            <div class="d-flex flex-wrap" style="gap:8px;">
                @if (!extractReadOnlyAfterCheck1Pass && doc.OcrStatus == OcrStatus.SearchablePdfReady)
                {
                    <form method="post" action="@applyOcrZonesUrl" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-figma btn-figma-outline btn-sm">
                            <i class="fas fa-magic mr-1"></i>Lấy dữ liệu từ OCR
                        </button>
                    </form>
                }
                <a href="@previewUrl" class="btn-figma btn-figma-secondary btn-sm" target="_blank" rel="noopener"><i class="fas fa-file-pdf mr-1"></i>Xem PDF</a>
                <a href="@indexUrl" class="btn-figma btn-figma-secondary btn-sm">Danh sách</a>
                <button type="button"
                        class="btn-figma btn-sm @(extractReadOnlyAfterCheck1Pass ? "btn-figma-secondary" : "btn-figma-primary")"
                        id="btnExtractSubmit"
                        data-can-submit="@(canSubmitExtract ? "true" : "false")"
                        data-block-reason="@extractBlockedReason"
                        title="@(canSubmitExtract ? "Lưu dữ liệu nhập liệu" : extractBlockedReason)"
                        @(canSubmitExtract ? null : "disabled")>
                    @if (extractReadOnlyAfterCheck1Pass)
                    {
                        <i class="fas fa-lock mr-1"></i><text>Chỉ xem (đã đạt check 1)</text>
                    }
                    else
                    {
                        <i class="fas fa-save mr-1"></i><text>Lưu &amp; hoàn thành nhập liệu</text>
                    }
                </button>
            </div>
        </div>
    </div>

    @if (extractReadOnlyAfterCheck1Pass)
    {
        <div class="alert alert-info border mb-3" role="alert">
            <div class="font-weight-bold mb-1"><i class="fas fa-info-circle mr-1"></i>Chế độ chỉ xem</div>
            <div class="mb-0 small">Kết quả kiểm tra lần 1 là <strong>Đạt</strong> — không thể chỉnh sửa hoặc lưu nhập liệu từ màn này.</div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(doc.Checked1ReturnReason))
    {
        <div class="alert alert-warning border mb-3" role="alert">
            <div class="font-weight-bold mb-1"><i class="fas fa-exclamation-triangle mr-1"></i>Kiểm tra lần 1 đã từ chối — vui lòng cập nhật nhập liệu theo phản hồi</div>
            <div class="mb-0 small">@doc.Checked1ReturnReason</div>
        </div>
    }

    <p id="extract-submit-hint" class="text-muted small d-none"><i class="fas fa-spinner fa-spin mr-1"></i>Đang gửi…</p>

    <div class="split-layout" id="extractSplitLayout">
        <div class="split-pane-left mb-3 mb-lg-0">
            <div class="card-figma h-100">
                <div class="card-header-figma d-flex align-items-center justify-content-between flex-wrap">
                    <h3 class="card-title-figma mb-0">Tài liệu</h3>
                    @if (showPdfViewer)
                    {
                        <a href="@previewUrl" class="btn-figma btn-figma-outline btn-sm" target="_blank" rel="noopener">Mở toàn màn hình</a>
                    }
                </div>
                <div class="card-content-figma p-0">
                    @if (showPdfViewer)
                    {
                        <div class="border-bottom bg-light px-2 py-1 small text-muted">
                            @if (doc.OcrStatus == OcrStatus.SearchablePdfReady)
                            {
                                <span><i class="fas fa-copy mr-1"></i>PDF 2 lớp: chọn chữ trên tài liệu bên dưới, <strong>Ctrl+C</strong> rồi dán vào các ô nhập liệu.</span>
                            }
                            else if (!string.IsNullOrEmpty(spLabel))
                            {
                                <span>@spLabel — khi xong, làm tương tự để copy nhanh hơn.</span>
                            }
                            else
                            {
                                <span>Đang hiển thị bản scan. Sau khi hệ thống tạo PDF 2 lớp, bạn có thể copy chữ từ đây.</span>
                            }
                        </div>
                        <div class="extract-pdf-toolbar">
                            <button type="button" class="btn-figma btn-figma-primary btn-sm" id="extractPdfNativeMode">PDF 2 lớp</button>
                            <button type="button" class="btn-figma btn-figma-outline btn-sm" id="extractPdfOcrMode">Vùng OCR</button>
                            <span class="border-left mx-1" style="height:20px;"></span>
                            <button type="button" class="btn-figma btn-figma-outline btn-sm" id="extractPdfPrevPage"><i class="fas fa-chevron-left"></i></button>
                            <span class="small text-muted">Trang <span id="extractPdfPageNo">0</span>/<span id="extractPdfPageCount">0</span></span>
                            <button type="button" class="btn-figma btn-figma-outline btn-sm" id="extractPdfNextPage"><i class="fas fa-chevron-right"></i></button>
                            <span class="border-left mx-1" style="height:20px;"></span>
                            <button type="button" class="btn-figma btn-figma-outline btn-sm" id="extractPdfZoomOut" title="Thu nhỏ"><i class="fas fa-search-minus"></i></button>
                            <span class="small text-muted" id="extractPdfZoomLabel">125%</span>
                            <button type="button" class="btn-figma btn-figma-outline btn-sm" id="extractPdfZoomIn" title="Phóng to"><i class="fas fa-search-plus"></i></button>
                        </div>
                        <div id="extractOcrViewer" class="extract-ocr-viewer">
                            <iframe id="extractPdfNativeFrame" src="@pdfRawUrl" title="PDF 2 lớp" class="extract-pdf-native-frame"></iframe>
                            <div id="extractOcrPage" class="extract-ocr-page extract-view-hidden">
                                <canvas id="extractOcrCanvas"></canvas>
                                <div id="extractPdfTextLayer" class="extract-pdf-text-layer"></div>
                                <div id="extractOcrZoneLayer" class="extract-ocr-zone-layer"></div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 text-muted small mb-0">Tài liệu không phải PDF — không có khung xem kèm.</div>
                    }
                </div>
            </div>
        </div>
        <div class="splitter" aria-hidden="true"></div>
        <div class="split-pane-right">
            <ul class="nav nav-tabs" id="extractTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="tab-doc-info-link" data-toggle="tab" href="#tab-doc-info" role="tab">Thông tin tài liệu</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="tab-record-info-link" data-toggle="tab" href="#tab-record-info" role="tab">Thông tin hồ sơ</a>
                </li>
                @if (hasOtherTab)
                {
                    <li class="nav-item">
                        <a class="nav-link" id="tab-other-link" data-toggle="tab" href="#tab-other" role="tab">Khác</a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link" id="tab-same-record-link" data-toggle="tab" href="#tab-same-record" role="tab">Tài liệu cùng bộ</a>
                </li>
                <li class="nav-item">
                    <span class="nav-link disabled">Ghi chú</span>
                </li>
                <li class="nav-item">
                    <span class="nav-link disabled">Cá nhân xử lý</span>
                </li>
            </ul>

            <div class="tab-content" id="extractTabsContent">
                <div class="tab-pane fade show active" id="tab-doc-info" role="tabpanel">
                    <div class="card-figma mb-3">
                        <div class="card-content-figma">
                            @if (docInfoFields.Count == 0)
                            {
                                <div class="text-muted small mb-0">Chưa có trường nào thuộc nhóm <strong>Thông tin tài liệu</strong>.</div>
                            }
                            else
                            {
                                <div class="row">
                                    @foreach (var fs in docInfoFields)
                                    {
                                        <div class="col-md-6">
                                            <partial name="_FieldInput" model="(fs, Fv(fs))" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="tab-record-info" role="tabpanel">
                    <div class="card-figma mb-3">
                        <div class="card-content-figma">
                            @if (recordInfoFields.Count == 0)
                            {
                                <div class="text-muted small mb-0">Chưa có trường nào thuộc nhóm <strong>Thông tin hồ sơ</strong>.</div>
                            }
                            else
                            {
                                <div class="row">
                                    @foreach (var fs in recordInfoFields)
                                    {
                                        <div class="col-md-6">
                                            <partial name="_FieldInput" model="(fs, Fv(fs))" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @if (hasOtherTab)
                {
                    <div class="tab-pane fade" id="tab-other" role="tabpanel">
                        @if (otherFields.Count > 0)
                        {
                            <div class="card-figma mb-3">
                                <div class="card-content-figma">
                                    <div class="row">
                                        @foreach (var fs in otherFields)
                                        {
                                            <div class="col-md-6">
                                                <partial name="_FieldInput" model="(fs, Fv(fs))" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        @if (cells.Count > 0)
                        {
                            <div class="card-figma mb-3">
                                <div class="card-header-figma">
                                    <h3 class="card-title-figma mb-0"><i class="fas fa-th mr-2" style="color:var(--primary);"></i>Ô nhập từ biểu mẫu / OCR</h3>
                                </div>
                                <div class="card-content-figma p-0">
                                    <div class="table-container-figma mb-0" style="max-height:360px; overflow:auto;">
                                        <table class="table table-sm table-figma mb-0">
                                            <thead>
                                                <tr>
                                                    <th>ID ô</th>
                                                    <th>Tiêu đề</th>
                                                    <th>Trang</th>
                                                    <th>OCR / đã nhập</th>
                                                    <th>Giá trị nhập</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var c in cells)
                                            {
                                                var showVal = string.IsNullOrEmpty(c.ExtractedValue) ? c.Value : c.ExtractedValue;
                                                <tr>
                                                    <td><code>@c.Id</code></td>
                                                    <td>@(c.Title ?? c.Field ?? "—")</td>
                                                    <td>@c.Page</td>
                                                    <td class="small text-muted text-truncate" style="max-width:180px;" title="@showVal">@showVal</td>
                                                    <td style="min-width:200px;">
                                                        <input type="text" class="form-control form-control-sm ext-cell" data-cell-id="@c.Id"
                                                               data-cell-label="Ô @(c.Title ?? c.Field ?? ("#" + c.Id))" maxlength="2000"
                                                               value="@c.ExtractedValue" placeholder="@c.Value" @(extractReadOnlyAfterCheck1Pass ? "readonly" : null) />
                                                    </td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="tab-pane fade" id="tab-same-record" role="tabpanel">
                    <div class="card-figma mb-3">
                        <div class="card-header-figma">
                            <h3 class="card-title-figma mb-0">Tài liệu cùng bộ hồ sơ</h3>
                        </div>
                        <div class="card-content-figma">
                            @if (sameRecordDocs.Count == 0)
                            {
                                <div class="alert alert-light border mb-0">Không có tài liệu cùng bộ hoặc chưa cấu hình <code>SetRecordInfo</code>.</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width:40px;">STT</th>
                                                <th>Phiếu</th>
                                                <th style="width:90px;">Đã nhận</th>
                                                <th style="width:130px;">Trạng thái</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @{
                                            var rowNo = 1;
                                            foreach (var sdoc in sameRecordDocs)
                                            {
                                                var isCurrent = sdoc.Id == doc.Id;
                                                var isEligibleForExtract = (!requireCheckFirstScan || sdoc.IsCheckedScan1)
                                                    && (!requireCheckSecondScan || sdoc.IsCheckedScan2);
                                                <tr>
                                                    <td>@rowNo</td>
                                                    <td>
                                                        @if (isCurrent)
                                                        {
                                                            <span class="text-danger font-weight-bold">@((sdoc.FileName ?? sdoc.Name) ?? $"#{sdoc.Id}")</span>
                                                        }
                                                        else
                                                        {
                                                            <a asp-area="sohoa" asp-controller="Extract" asp-action="Form" asp-route-id="@sdoc.Id">
                                                                @((sdoc.FileName ?? sdoc.Name) ?? $"#{sdoc.Id}")
                                                            </a>
                                                        }
                                                    </td>
                                                    <td class="text-center">@(sdoc.ExtractedBy > 0 || isCurrent ? "✔" : "")</td>
                                                    <td>
                                                        @if (isCurrent)
                                                        {
                                                            <span class="badge badge-info">Đang nhập</span>
                                                        }
                                                        else if (sdoc.IsExtracted)
                                                        {
                                                            <span class="badge badge-success">Đã nhập</span>
                                                        }
                                                        else if (!isEligibleForExtract)
                                                        {
                                                            <span class="badge badge-secondary">Không đủ điều kiện</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Chưa nhập</span>
                                                        }
                                                    </td>
                                                </tr>
                                                rowNo++;
                                            }
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="antiEx" class="d-none">@Html.AntiForgeryToken()</form>
<div id="extractOcrContext" class="extract-ocr-context">
    <button type="button" class="btn-figma btn-figma-primary btn-sm w-100" id="extractOcrAgainBtn">
        <i class="fas fa-sync-alt mr-1"></i>OCR lại
    </button>
</div>

@section Scripts {
    <script src="~/js/shtl-ajax.js" asp-append-version="true"></script>
    <script src="~/js/sohoa/field-input-enhance.js" asp-append-version="true"></script>
    <script>
        (function () {
            var submitUrl = @Html.Raw(JsonSerializer.Serialize(submitUrl));
            var ocrTemporaryZoneUrl = @Html.Raw(JsonSerializer.Serialize(ocrTemporaryZoneUrl));
            var docId = @doc.Id;
            var ocrZones = @Html.Raw(JsonSerializer.Serialize(ocrZonesForClient));
            var pdfUrl = @Html.Raw(JsonSerializer.Serialize(pdfRawUrl));
            var compatibilityJsUrl = @Html.Raw(JsonSerializer.Serialize(compatibilityJsUrl));
            var pdfJsUrl = @Html.Raw(JsonSerializer.Serialize(pdfJsUrl));
            var pdfWorkerUrl = @Html.Raw(JsonSerializer.Serialize(pdfWorkerUrl));
            var ocrZoneByFieldSetting = {};
            var activeOcrZone = null;
            var activeOcrGroup = null;
            var extractPdfDoc = null;
            var extractPdfCurrentPage = 1;
            var extractPdfRendering = false;
            var extractPdfPendingPage = null;
            var extractPdfScale = 1.25;
            var extractPdfMode = 'native';
            var resizeState = null;
            initSplitLayout('extractSplitLayout');
            initExtractViewMode();
            initExtractPdfViewer();
            initOcrZoneHighlight();

            function initSplitLayout(layoutId) {
                var layout = document.getElementById(layoutId);
                if (!layout) return;
                var leftPane = layout.querySelector('.split-pane-left');
                var splitter = layout.querySelector('.splitter');
                if (!leftPane || !splitter) return;

                function syncHeight() {
                    if (window.innerWidth < 992) {
                        layout.style.height = '';
                        return;
                    }
                    var top = layout.getBoundingClientRect().top;
                    var margin = 16; // chừa ~ khoảng đệm dưới
                    var h = Math.max(420, window.innerHeight - top - margin);
                    layout.style.height = h + 'px';
                }
                syncHeight();
                window.addEventListener('resize', syncHeight);
                window.addEventListener('load', syncHeight);

                var dragging = false;
                var startX = 0;
                var startWidth = 0;
                var blockedIframes = [];

                splitter.addEventListener('mousedown', function (e) {
                    if (window.innerWidth < 992) return;
                    dragging = true;
                    startX = e.clientX;
                    startWidth = leftPane.getBoundingClientRect().width;
                    blockedIframes = Array.prototype.slice.call(layout.querySelectorAll('iframe'));
                    blockedIframes.forEach(function (f) { f.style.pointerEvents = 'none'; });
                    splitter.classList.add('is-dragging');
                    document.body.style.cursor = 'col-resize';
                    document.body.style.userSelect = 'none';
                    e.preventDefault();
                });

                window.addEventListener('mousemove', function (e) {
                    if (!dragging) return;
                    var dx = e.clientX - startX;
                    var newWidth = startWidth + dx;
                    var total = layout.getBoundingClientRect().width;
                    var minWidth = 320;
                    var maxWidth = Math.max(minWidth, total - 360 - 10);
                    newWidth = Math.max(minWidth, Math.min(maxWidth, newWidth));
                    var percent = (newWidth / total) * 100;
                    leftPane.style.flexBasis = percent.toFixed(2) + '%';
                });

                window.addEventListener('mouseup', function () {
                    if (!dragging) return;
                    dragging = false;
                    blockedIframes.forEach(function (f) { f.style.pointerEvents = ''; });
                    blockedIframes = [];
                    splitter.classList.remove('is-dragging');
                    document.body.style.cursor = '';
                    document.body.style.userSelect = '';
                });
            }

            function loadScript(url) {
                return new Promise(function (resolve, reject) {
                    if (document.querySelector('script[data-extract-pdf-src="' + url + '"]')) {
                        resolve();
                        return;
                    }
                    var el = document.createElement('script');
                    el.src = url;
                    el.setAttribute('data-extract-pdf-src', url);
                    el.onload = resolve;
                    el.onerror = function () { reject(new Error(url)); };
                    document.head.appendChild(el);
                });
            }

            function initExtractViewMode() {
                var nativeBtn = document.getElementById('extractPdfNativeMode');
                var ocrBtn = document.getElementById('extractPdfOcrMode');
                if (nativeBtn) nativeBtn.onclick = function () { setExtractPdfMode('native'); };
                if (ocrBtn) ocrBtn.onclick = function () { setExtractPdfMode('ocr'); };
                setExtractPdfMode('native');
            }

            function setExtractPdfMode(mode) {
                extractPdfMode = mode === 'ocr' ? 'ocr' : 'native';
                var nativeFrame = document.getElementById('extractPdfNativeFrame');
                var ocrPage = document.getElementById('extractOcrPage');
                var nativeBtn = document.getElementById('extractPdfNativeMode');
                var ocrBtn = document.getElementById('extractPdfOcrMode');
                var canvasControls = [
                    document.getElementById('extractPdfPrevPage'),
                    document.getElementById('extractPdfNextPage'),
                    document.getElementById('extractPdfZoomOut'),
                    document.getElementById('extractPdfZoomIn')
                ];
                var zoomLabel = document.getElementById('extractPdfZoomLabel');

                if (nativeFrame) nativeFrame.classList.toggle('extract-view-hidden', extractPdfMode !== 'native');
                if (ocrPage) ocrPage.classList.toggle('extract-view-hidden', extractPdfMode !== 'ocr');
                if (nativeBtn) {
                    nativeBtn.classList.toggle('btn-figma-primary', extractPdfMode === 'native');
                    nativeBtn.classList.toggle('btn-figma-outline', extractPdfMode !== 'native');
                }
                if (ocrBtn) {
                    ocrBtn.classList.toggle('btn-figma-primary', extractPdfMode === 'ocr');
                    ocrBtn.classList.toggle('btn-figma-outline', extractPdfMode !== 'ocr');
                }
                canvasControls.forEach(function (btn) {
                    if (btn) btn.disabled = extractPdfMode !== 'ocr';
                });
                if (zoomLabel) zoomLabel.classList.toggle('text-muted', extractPdfMode !== 'ocr');

                if (extractPdfMode === 'ocr' && extractPdfDoc && !extractPdfRendering) {
                    renderExtractPdfPage(extractPdfCurrentPage, true);
                }
            }

            function initExtractPdfViewer() {
                var viewer = document.getElementById('extractOcrViewer');
                if (!viewer || !pdfUrl) return;

                loadScript(compatibilityJsUrl).catch(function () { return null; })
                    .then(function () { return loadScript(pdfJsUrl); })
                    .then(function () {
                        if (typeof PDFJS === 'undefined') {
                            showExtractPdfFallback('PDFJS undefined');
                            return;
                        }
                        PDFJS.workerSrc = pdfWorkerUrl;
                        return PDFJS.getDocument(pdfUrl);
                    })
                    .then(function (pdfDoc) {
                        if (!pdfDoc) return;
                        extractPdfDoc = pdfDoc;
                        var total = document.getElementById('extractPdfPageCount');
                        if (total) total.textContent = String(pdfDoc.numPages);
                        bindExtractPdfPager();
                        bindExtractPdfZoom();
                        updateExtractPdfZoomLabel();
                        renderExtractPdfPage(1);
                    })
                    .catch(function (err) {
                        showExtractPdfFallback(err && err.message ? err.message : 'load pdf failed');
                    });
            }

            function showExtractPdfFallback(detail) {
                var viewer = document.getElementById('extractOcrViewer');
                if (!viewer) return;
                viewer.innerHTML = '<div class="p-3 text-danger small">Khong tai duoc PDF.js de hien thi vung OCR. '
                    + (detail || '') + '</div>'
                    + '<iframe src="' + pdfUrl + '" title="PDF tai lieu" class="w-100 border-0" style="min-height:520px;"></iframe>';
            }

            function bindExtractPdfPager() {
                var prev = document.getElementById('extractPdfPrevPage');
                var next = document.getElementById('extractPdfNextPage');
                if (prev) {
                    prev.onclick = function () {
                        if (!extractPdfDoc || extractPdfCurrentPage <= 1) return;
                        activeOcrZone = null;
                        renderExtractPdfPage(extractPdfCurrentPage - 1);
                    };
                }
                if (next) {
                    next.onclick = function () {
                        if (!extractPdfDoc || extractPdfCurrentPage >= extractPdfDoc.numPages) return;
                        activeOcrZone = null;
                        renderExtractPdfPage(extractPdfCurrentPage + 1);
                    };
                }
            }

            function bindExtractPdfZoom() {
                var zoomOut = document.getElementById('extractPdfZoomOut');
                var zoomIn = document.getElementById('extractPdfZoomIn');
                if (zoomOut) {
                    zoomOut.onclick = function () {
                        setExtractPdfScale(extractPdfScale - 0.25);
                    };
                }
                if (zoomIn) {
                    zoomIn.onclick = function () {
                        setExtractPdfScale(extractPdfScale + 0.25);
                    };
                }
            }

            function setExtractPdfScale(scale) {
                var nextScale = Math.max(0.5, Math.min(3, Math.round(scale * 4) / 4));
                if (Math.abs(nextScale - extractPdfScale) < 0.001) return;
                extractPdfScale = nextScale;
                updateExtractPdfZoomLabel();
                renderExtractPdfPage(extractPdfCurrentPage, true);
            }

            function updateExtractPdfZoomLabel() {
                var label = document.getElementById('extractPdfZoomLabel');
                if (label) label.textContent = Math.round(extractPdfScale * 100) + '%';
            }

            function renderExtractPdfPage(pageNumber, force) {
                if (!extractPdfDoc) return Promise.resolve();
                pageNumber = Math.max(1, Math.min(extractPdfDoc.numPages, parseInt(pageNumber, 10) || 1));
                if (extractPdfRendering) {
                    extractPdfPendingPage = pageNumber;
                    return Promise.resolve();
                }
                extractPdfRendering = true;
                extractPdfPendingPage = null;
                extractPdfCurrentPage = pageNumber;
                var pageNo = document.getElementById('extractPdfPageNo');
                if (pageNo) pageNo.textContent = String(pageNumber);

                return extractPdfDoc.getPage(pageNumber).then(function (page) {
                    var canvas = document.getElementById('extractOcrCanvas');
                    var layer = document.getElementById('extractOcrZoneLayer');
                    var textLayer = document.getElementById('extractPdfTextLayer');
                    if (!canvas || !layer || !textLayer) return;
                    var viewport = page.getViewport(extractPdfScale);
                    canvas.width = viewport.width;
                    canvas.height = viewport.height;
                    layer.style.width = viewport.width + 'px';
                    layer.style.height = viewport.height + 'px';
                    textLayer.style.width = viewport.width + 'px';
                    textLayer.style.height = viewport.height + 'px';
                    textLayer.innerHTML = '';
                    return page.render({ canvasContext: canvas.getContext('2d'), viewport: viewport }).promise
                        .then(function () { return renderExtractPdfTextLayer(page, viewport, textLayer); });
                }).then(function () {
                    extractPdfRendering = false;
                    drawOcrZone(activeOcrZone);
                    if (extractPdfPendingPage) {
                        var pending = extractPdfPendingPage;
                        extractPdfPendingPage = null;
                        renderExtractPdfPage(pending, true);
                    }
                }).catch(function (err) {
                    extractPdfRendering = false;
                    showExtractPdfFallback(err && err.message ? err.message : 'render page failed');
                });
            }

            function renderExtractPdfTextLayer(page, viewport, textLayer) {
                if (!page || !textLayer || !PDFJS || !PDFJS.Util) return Promise.resolve();
                return page.getTextContent().then(function (textContent) {
                    textLayer.innerHTML = '';
                    (textContent.items || []).forEach(function (item) {
                        if (!item || !item.str) return;
                        var tx = PDFJS.Util.transform(viewport.transform, item.transform);
                        var fontHeight = Math.sqrt((tx[2] * tx[2]) + (tx[3] * tx[3]));
                        if (!fontHeight || !isFinite(fontHeight)) fontHeight = Math.abs(tx[3]) || 10;
                        var angle = Math.atan2(tx[1], tx[0]);
                        var span = document.createElement('span');
                        span.textContent = item.str;
                        span.style.left = tx[4] + 'px';
                        span.style.top = (tx[5] - fontHeight) + 'px';
                        span.style.fontSize = fontHeight + 'px';
                        span.style.fontFamily = item.fontName || 'sans-serif';
                        if (angle) span.style.transform = 'rotate(' + angle + 'rad)';
                        textLayer.appendChild(span);
                    });
                });
            }

            function initOcrZoneHighlight() {
                (ocrZones || []).forEach(function (zone) {
                    if (zone && zone.fieldSettingId) {
                        ocrZoneByFieldSetting[String(zone.fieldSettingId)] = zone;
                    }
                });

                document.querySelectorAll('.ext-field-group[data-field-setting-id]').forEach(function (group) {
                    var zone = ocrZoneByFieldSetting[group.getAttribute('data-field-setting-id')];
                    if (!zone) return;
                    group.classList.add('has-ocr-zone');
                    group.setAttribute('title', 'Click de xem vung OCR tuong ung tren PDF');
                    group.querySelectorAll('[data-stg-field]').forEach(function (el) {
                        el.addEventListener('focus', function () { activateOcrZone(group, zone); });
                        el.addEventListener('click', function () { activateOcrZone(group, zone); });
                    });
                });
            }

            function activateOcrZone(group, zone) {
                setExtractPdfMode('ocr');
                activeOcrZone = zone;
                activeOcrGroup = group;
                document.querySelectorAll('.ext-field-group.is-ocr-zone-active').forEach(function (el) {
                    el.classList.remove('is-ocr-zone-active');
                });
                group.classList.add('is-ocr-zone-active');
                scheduleDrawOcrZone(zone);
            }

            function scheduleDrawOcrZone(zone) {
                if (!zone) return;
                var pageNumber = parseInt(zone.pageNumber, 10) || 1;
                if (extractPdfDoc && extractPdfCurrentPage !== pageNumber) {
                    renderExtractPdfPage(pageNumber);
                    return;
                }
                drawOcrZone(zone);
            }

            function drawOcrZone(zone) {
                var layer = document.getElementById('extractOcrZoneLayer');
                var viewer = document.getElementById('extractOcrViewer');
                if (!layer) return;
                layer.innerHTML = '';
                if (!zone || (parseInt(zone.pageNumber, 10) || 1) !== extractPdfCurrentPage) return;

                var el = document.createElement('div');
                el.className = 'extract-ocr-zone';
                el.style.left = (toRatio(zone.xRatio) * 100) + '%';
                el.style.top = (toRatio(zone.yRatio) * 100) + '%';
                el.style.width = (toRatio(zone.widthRatio) * 100) + '%';
                el.style.height = (toRatio(zone.heightRatio) * 100) + '%';
                var label = document.createElement('div');
                label.className = 'extract-ocr-zone-label';
                label.textContent = zone.label || 'OCR';
                el.appendChild(label);
                ['nw', 'ne', 'sw', 'se'].forEach(function (pos) {
                    var handle = document.createElement('span');
                    handle.className = 'extract-ocr-handle extract-ocr-handle-' + pos;
                    handle.setAttribute('data-handle', pos);
                    el.appendChild(handle);
                });
                bindOcrZoneEditing(el, zone);
                layer.appendChild(el);
                if (viewer) {
                    try { el.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' }); } catch (e) { el.scrollIntoView(); }
                }
            }

            function bindOcrZoneEditing(el, zone) {
                el.addEventListener('contextmenu', function (e) {
                    e.preventDefault();
                    showOcrContext(e.clientX, e.clientY);
                });
                el.addEventListener('mousedown', function (e) {
                    if (e.button !== 0) return;
                    var handle = e.target && e.target.getAttribute ? e.target.getAttribute('data-handle') : '';
                    startOcrResize(e, zone, handle || 'move');
                });
            }

            function startOcrResize(e, zone, mode) {
                var layer = document.getElementById('extractOcrZoneLayer');
                if (!layer) return;
                var rect = layer.getBoundingClientRect();
                resizeState = {
                    zone: zone,
                    mode: mode,
                    layerRect: rect,
                    startX: e.clientX,
                    startY: e.clientY,
                    x: toRatio(zone.xRatio),
                    y: toRatio(zone.yRatio),
                    w: toRatio(zone.widthRatio),
                    h: toRatio(zone.heightRatio)
                };
                document.addEventListener('mousemove', onOcrResizeMove);
                document.addEventListener('mouseup', stopOcrResize);
                e.preventDefault();
                e.stopPropagation();
            }

            function onOcrResizeMove(e) {
                if (!resizeState) return;
                var dx = (e.clientX - resizeState.startX) / Math.max(1, resizeState.layerRect.width);
                var dy = (e.clientY - resizeState.startY) / Math.max(1, resizeState.layerRect.height);
                var x = resizeState.x;
                var y = resizeState.y;
                var w = resizeState.w;
                var h = resizeState.h;
                var minSize = 0.01;

                if (resizeState.mode === 'move') {
                    x += dx; y += dy;
                } else {
                    if (resizeState.mode.indexOf('w') >= 0) { x += dx; w -= dx; }
                    if (resizeState.mode.indexOf('e') >= 0) { w += dx; }
                    if (resizeState.mode.indexOf('n') >= 0) { y += dy; h -= dy; }
                    if (resizeState.mode.indexOf('s') >= 0) { h += dy; }
                }

                if (w < minSize) w = minSize;
                if (h < minSize) h = minSize;
                if (x < 0) { w += x; x = 0; }
                if (y < 0) { h += y; y = 0; }
                if (x + w > 1) w = 1 - x;
                if (y + h > 1) h = 1 - y;

                resizeState.zone.xRatio = x;
                resizeState.zone.yRatio = y;
                resizeState.zone.widthRatio = Math.max(minSize, w);
                resizeState.zone.heightRatio = Math.max(minSize, h);
                drawOcrZone(resizeState.zone);
            }

            function stopOcrResize() {
                document.removeEventListener('mousemove', onOcrResizeMove);
                document.removeEventListener('mouseup', stopOcrResize);
                resizeState = null;
            }

            function showOcrContext(x, y) {
                var menu = document.getElementById('extractOcrContext');
                if (!menu) return;
                menu.style.display = 'block';
                menu.style.left = x + 'px';
                menu.style.top = y + 'px';
            }

            document.addEventListener('click', function (e) {
                var menu = document.getElementById('extractOcrContext');
                if (menu && !menu.contains(e.target)) menu.style.display = 'none';
            });

            var ocrAgainBtn = document.getElementById('extractOcrAgainBtn');
            if (ocrAgainBtn) {
                ocrAgainBtn.addEventListener('click', function () {
                    var menu = document.getElementById('extractOcrContext');
                    if (menu) menu.style.display = 'none';
                    ocrAgainActiveZone();
                });
            }

            function ocrAgainActiveZone() {
                if (!activeOcrZone || !activeOcrGroup) return;
                var btn = document.getElementById('extractOcrAgainBtn');
                if (btn) btn.disabled = true;
                fetch(ocrTemporaryZoneUrl, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token()
                    },
                    body: JSON.stringify({
                        fieldSettingId: activeOcrZone.fieldSettingId,
                        pageNumber: activeOcrZone.pageNumber,
                        xRatio: toRatio(activeOcrZone.xRatio),
                        yRatio: toRatio(activeOcrZone.yRatio),
                        widthRatio: toRatio(activeOcrZone.widthRatio),
                        heightRatio: toRatio(activeOcrZone.heightRatio)
                    })
                }).then(function (r) { return r.json(); }).then(function (j) {
                    if (!j || !j.success) {
                        toastErrorLong((j && j.message) || 'OCR lai vung that bai.');
                        return;
                    }
                    applyOcrValueToActiveField(j.data || j.Data);
                    if (typeof toastr !== 'undefined') toastr.success(j.message || j.Message || 'Da OCR lai vung.');
                }).catch(function (err) {
                    toastErrorLong('Loi OCR lai vung. ' + (err && err.message ? err.message : ''));
                }).finally(function () {
                    if (btn) btn.disabled = false;
                });
            }

            function applyOcrValueToActiveField(data) {
                if (!data || !activeOcrGroup) return;
                var key = data.fieldKey || data.FieldKey;
                var value = (data.value || data.Value || '').toString().trim();
                var input = key
                    ? activeOcrGroup.querySelector('[data-stg-field="' + cssEscape(key) + '"]')
                    : activeOcrGroup.querySelector('[data-stg-field]');
                if (!input) input = activeOcrGroup.querySelector('[data-stg-field]');
                if (!input) return;
                if (input.classList.contains('ext-date')) {
                    value = formatDateForDisplay(value);
                    input.dataset.rawSnapshot = value;
                }
                input.value = '';
                input.value = value;
                input.dispatchEvent(new Event('input', { bubbles: true }));
                input.dispatchEvent(new Event('change', { bubbles: true }));
                try { input.focus(); } catch (e) { /* ignore */ }
            }

            function cssEscape(value) {
                if (window.CSS && window.CSS.escape) return window.CSS.escape(value);
                return String(value).replace(/"/g, '\\"');
            }

            function formatDateForDisplay(value) {
                var m = String(value || '').match(/^(\d{4})-(\d{2})-(\d{2})/);
                return m ? (m[3] + '/' + m[2] + '/' + m[1]) : value;
            }

            function toRatio(value) {
                var n = parseFloat(value);
                if (!isFinite(n)) return 0;
                if (n > 1 && n <= 100) n = n / 100;
                if (n < 0) return 0;
                if (n > 1) return 1;
                return n;
            }

            function token() {
                return window.ShtlAjax.getRequestVerificationToken();
            }

            function toastErrorLong(msg) {
                if (typeof toastr !== 'undefined') {
                    toastr.error(msg, '', { timeOut: 90000, closeButton: true, tapToDismiss: true, newestOnTop: true });
                }
            }

            function validateExtractDateInputs() {
                var fields = document.querySelectorAll('.ext-date[data-stg-field]');
                function labelOf(el) {
                    var fg = el.closest('.form-group');
                    var label = fg ? fg.querySelector('label') : null;
                    return label ? label.innerText.replace('*', '').trim() : 'trường ngày';
                }
                for (var i = 0; i < fields.length; i++) {
                    var el = fields[i];
                    var raw = (el.value || '').trim();
                    if (el.dataset && el.dataset.rawSnapshot && el.dataset.rawSnapshot.trim().length > 0) {
                        raw = el.dataset.rawSnapshot.trim();
                    }
                    el.classList.remove('is-invalid');
                    if (raw.length === 0) continue;
                    var m = raw.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})$/);
                    if (!m) {
                        el.classList.add('is-invalid');
                        return { ok: false, firstInvalid: el, message: 'Trường "' + labelOf(el) + '" phải đúng định dạng dd/MM/yyyy.' };
                    }
                    var dd = parseInt(m[1], 10);
                    var mm = parseInt(m[2], 10);
                    var yy = parseInt(m[3], 10);
                    var d = new Date(yy, mm - 1, dd);
                    if (d.getFullYear() !== yy || d.getMonth() !== mm - 1 || d.getDate() !== dd) {
                        el.classList.add('is-invalid');
                        return { ok: false, firstInvalid: el, message: 'Trường "' + labelOf(el) + '" có ngày không hợp lệ.' };
                    }
                }
                return { ok: true };
            }

            document.getElementById('btnExtractSubmit').onclick = function () {
                var submitBtn = document.getElementById('btnExtractSubmit');
                if (submitBtn.getAttribute('data-can-submit') !== 'true') {
                    toastErrorLong(submitBtn.getAttribute('data-block-reason') || 'Tài liệu chưa đủ điều kiện nhập liệu.');
                    return;
                }
                if (window.ShtlFieldInputEnhance && window.ShtlFieldInputEnhance.validateBeforeSubmit) {
                    var v = window.ShtlFieldInputEnhance.validateBeforeSubmit(document);
                    if (!v.ok) {
                        toastErrorLong(v.message);
                        window.ShtlFieldInputEnhance.focusFirstInvalid(document);
                        return;
                    }
                }
                var dateValidation = validateExtractDateInputs();
                if (!dateValidation.ok) {
                    toastErrorLong(dateValidation.message);
                    try { dateValidation.firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) { /* ignore */ }
                    try { dateValidation.firstInvalid.focus(); } catch (e) { /* ignore */ }
                    return;
                }
                var stg = {};
                var getVal = (window.ShtlFieldInputEnhance && window.ShtlFieldInputEnhance.getSubmitValue)
                    ? window.ShtlFieldInputEnhance.getSubmitValue
                    : function (el) { return el.value; };
                document.querySelectorAll('[data-stg-field]').forEach(function (el) {
                    var k = el.getAttribute('data-stg-field');
                    if (k) stg[k] = getVal(el);
                });
                var cells = [];
                document.querySelectorAll('.ext-cell[data-cell-id]').forEach(function (el) {
                    var id = parseInt(el.getAttribute('data-cell-id'), 10);
                    if (id) cells.push({ id: id, value: el.value });
                });
                var body = { documentId: docId, cells: cells, stgFieldValues: stg };
                for (var n = 9; n <= 15; n++) {
                    var key = 'field' + n;
                    if (stg[key] !== undefined && stg[key] !== '') body[key] = stg[key];
                }
                var hint = document.getElementById('extract-submit-hint');
                hint.classList.remove('d-none');
                fetch(submitUrl, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token()
                    },
                    body: JSON.stringify(body)
                }).then(function (r) {
                    return r.text().then(function (text) {
                        return { ok: r.ok, status: r.status, text: text };
                    });
                }).then(function (res) {
                    hint.classList.add('d-none');
                    var j = null;
                    try {
                        j = res.text ? JSON.parse(res.text) : null;
                    } catch (e) {
                        j = null;
                    }
                    if (!res.ok) {
                        var msg = (j && j.message) ? j.message : ('HTTP ' + res.status);
                        if (!j && res.text) {
                            var t = res.text.replace(/<[^>]+>/g, ' ').trim();
                            if (t.length > 220) t = t.substring(0, 220) + '…';
                            if (t) msg += ' — ' + t;
                        }
                        if (res.status === 400 && !j) msg = 'Phiên hết hạn hoặc lỗi bảo mật (antiforgery). Tải lại trang rồi thử lưu.';
                        toastErrorLong(msg);
                        return;
                    }
                    if (!j) {
                        toastErrorLong('Phản hồi không hợp lệ từ server.');
                        return;
                    }
                    if (j.success) {
                        if (typeof toastr !== 'undefined') toastr.success(j.message || 'Đã lưu');
                        window.location.href = @Html.Raw(JsonSerializer.Serialize(indexUrl));
                    } else {
                        toastErrorLong(j.message || 'Lỗi');
                    }
                }).catch(function (err) {
                    hint.classList.add('d-none');
                    var msg = 'Lỗi mạng hoặc trình duyệt chặn yêu cầu.';
                    if (err && err.message) msg += ' ' + err.message;
                    toastErrorLong(msg);
                });
            };
        })();
    </script>
}
