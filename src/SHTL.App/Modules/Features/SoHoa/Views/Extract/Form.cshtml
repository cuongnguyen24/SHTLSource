@model DocumentFormViewModel
@using System.Text.Json
@using SHTL.Modules.Core.Domain.Enums
@using SHTL.Modules.Shared.Contracts
@using SHTL.Modules.Shared.Contracts.ViewModels
@{
    var doc = Model.Document!;
    var extractReadOnlyAfterCheck1Pass = doc.IsChecked1 || doc.Checked1Result == StepResult.Pass;
    ViewData["ExtractFormReadOnly"] = extractReadOnlyAfterCheck1Pass;
    ViewData["Title"] = extractReadOnlyAfterCheck1Pass ? ("Xem nhập liệu — " + doc.Name) : ("Nhập liệu — " + doc.Name);
    var submitUrl = Url.Action("Submit", "Extract", new { area = "sohoa" })!;
    var previewUrl = Url.Content("~/scan/preview/" + doc.Id);
    var indexUrl = Url.Action("Index", "Extract", new { area = "sohoa" })!;
    var pdfViewerUrl = Url.Content("~/scan/pdf/" + doc.Id);
    var showPdfViewer = SearchablePdfDisplay.LooksLikePdf(doc.Extension, doc.FileName, doc.FilePath);
    var spLabel = doc.SearchablePdfStatusText;

    string? Fv(FieldSettingViewModel f)
    {
        if (!string.IsNullOrWhiteSpace(f.FieldName) && Model.FieldValues.TryGetValue(f.FieldName, out var x))
            return x;

        // Fallback by FieldId for legacy settings where FieldName is missing/misaligned.
        string[] keys = f.FieldId switch
        {
            1 => new[] { "dc_title", "name" },
            2 => new[] { "dc_symbol", "symbol_no", "symbolno" },
            3 => new[] { "issuer", "dc_issued_by", "issued_by", "issuedby" },
            4 => new[] { "receiver", "dc_receiver" },
            5 => new[] { "subject", "describe" },
            6 => new[] { "levelno", "dc_box", "level_no" },
            7 => new[] { "boxno", "dc_num1", "box_no", "hop_so" },
            8 => new[] { "recordno", "dc_record", "record_no", "ho_so_so" },
            9 => new[] { "recordtitle", "fc_title", "record_title" },
            10 => new[] { "poster", "author" },
            11 => new[] { "signer" },
            12 => new[] { "slotno", "slot_no" },
            13 => new[] { "shelfno", "shelf_no" },
            14 => new[] { "noted", "dc_noted" },
            15 => new[] { "fc_dec1", "field23" },
            16 => new[] { "fc_date1", "field22" },
            17 => new[] { "std_text", "field15" },
            18 => new[] { "std_num", "field16" },
            19 => new[] { "std_dec", "field23" },
            20 => new[] { "std_date", "field21" },
            >= 101 and <= 125 => new[] { $"field{f.FieldId - 100}" },
            _ => Array.Empty<string>()
        };
        foreach (var key in keys)
        {
            if (Model.FieldValues.TryGetValue(key, out var mapped) && !string.IsNullOrWhiteSpace(mapped))
                return mapped;
        }

        // Preserve title behavior from physical file_name.
        if (f.FieldId == 1)
            return !string.IsNullOrWhiteSpace(doc.FileName) ? doc.FileName : doc.Name;

        return f.FixValue;
    }

    var orderedFields = Model.FieldSettings.OrderBy(f => f.Weight).ToList();
    var cells = Model.Cells.OrderBy(c => c.Page).ThenBy(c => c.Y).ThenBy(c => c.X).ToList();
    var sameRecordDocs = Model.SameRecordDocuments ?? Array.Empty<DocumentDto>();
    var requireCheckFirstScan = (bool?)ViewBag.RequireCheckFirstScan ?? true;
    var requireCheckSecondScan = (bool?)ViewBag.RequireCheckSecondScan ?? true;
    var scanOkForExtract = (!requireCheckFirstScan || doc.IsCheckedScan1) && (!requireCheckSecondScan || doc.IsCheckedScan2);
    // Đã nhập nhưng chưa đạt check 1 (hoặc bị trả về) mới được sửa/lưu lại.
    var canReEditExtractBeforeCheck1 = doc.IsExtracted && !extractReadOnlyAfterCheck1Pass;
    var canSubmitExtract = !extractReadOnlyAfterCheck1Pass && (scanOkForExtract || canReEditExtractBeforeCheck1);
    string extractBlockedReason;
    if (extractReadOnlyAfterCheck1Pass)
        extractBlockedReason = "Đã đạt kiểm tra lần 1 — chỉ xem, không lưu nhập liệu.";
    else if (!canSubmitExtract)
        extractBlockedReason = $"Tài liệu chưa đủ điều kiện nhập liệu: {(requireCheckFirstScan && !doc.IsCheckedScan1 ? "Check scan 1" : string.Empty)}{(requireCheckFirstScan && !doc.IsCheckedScan1 && requireCheckSecondScan && !doc.IsCheckedScan2 ? ", " : string.Empty)}{(requireCheckSecondScan && !doc.IsCheckedScan2 ? "Check scan 2" : string.Empty)} chưa hoàn thành.";
    else
        extractBlockedReason = string.Empty;
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-area="sohoa" asp-controller="Extract" asp-action="Index">Nhập liệu</a></li>
    <li class="breadcrumb-item active">#@doc.Id</li>
}
@section Styles {
    <style>
        .split-layout {
            display: flex;
            align-items: stretch;
            min-height: calc(100vh - 220px);
        }
        .split-pane-left {
            flex: 0 0 42%;
            min-width: 320px;
            max-width: 78%;
        }
        .split-pane-right {
            flex: 1 1 auto;
            min-width: 360px;
        }
        .splitter {
            width: 10px;
            cursor: col-resize;
            position: relative;
            user-select: none;
        }
        .splitter::before {
            content: "";
            position: absolute;
            left: 4px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #dee2e6;
        }
        .splitter.is-dragging::before {
            background: var(--primary);
        }
        @@media (max-width: 991.98px) {
            .split-layout {
                display: block;
                min-height: auto;
            }
            .split-pane-left,
            .split-pane-right {
                min-width: 0;
                max-width: none;
                width: 100%;
            }
            .splitter { display: none; }
        }
    </style>
}

<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div>
                <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">@doc.Name</h6>
                <div class="text-muted small">
                    Loại: @Model.DocType.Name · Bước hiện tại: @doc.CurrentStep
                    @if (!string.IsNullOrEmpty(spLabel))
                    {
                        <span class="badge badge-info ml-1">@spLabel</span>
                    }
                </div>
            </div>
            <div class="d-flex flex-wrap" style="gap:8px;">
                <a href="@previewUrl" class="btn-figma btn-figma-secondary btn-sm" target="_blank" rel="noopener"><i class="fas fa-file-pdf mr-1"></i>Xem PDF</a>
                <a href="@indexUrl" class="btn-figma btn-figma-secondary btn-sm">Danh sách</a>
                <button type="button"
                        class="btn-figma btn-sm @(extractReadOnlyAfterCheck1Pass ? "btn-figma-secondary" : "btn-figma-primary")"
                        id="btnExtractSubmit"
                        data-can-submit="@(canSubmitExtract ? "true" : "false")"
                        data-block-reason="@extractBlockedReason"
                        title="@(canSubmitExtract ? "Lưu dữ liệu nhập liệu" : extractBlockedReason)"
                        @(canSubmitExtract ? null : "disabled")>
                    @if (extractReadOnlyAfterCheck1Pass)
                    {
                        <i class="fas fa-lock mr-1"></i><text>Chỉ xem (đã đạt check 1)</text>
                    }
                    else
                    {
                        <i class="fas fa-save mr-1"></i><text>Lưu &amp; hoàn thành nhập liệu</text>
                    }
                </button>
            </div>
        </div>
    </div>

    @if (extractReadOnlyAfterCheck1Pass)
    {
        <div class="alert alert-info border mb-3" role="alert">
            <div class="font-weight-bold mb-1"><i class="fas fa-info-circle mr-1"></i>Chế độ chỉ xem</div>
            <div class="mb-0 small">Kết quả kiểm tra lần 1 là <strong>Đạt</strong> — không thể chỉnh sửa hoặc lưu nhập liệu từ màn này.</div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(doc.Checked1ReturnReason))
    {
        <div class="alert alert-warning border mb-3" role="alert">
            <div class="font-weight-bold mb-1"><i class="fas fa-exclamation-triangle mr-1"></i>Kiểm tra lần 1 đã từ chối — vui lòng cập nhật nhập liệu theo phản hồi</div>
            <div class="mb-0 small">@doc.Checked1ReturnReason</div>
        </div>
    }

    <p id="extract-submit-hint" class="text-muted small d-none"><i class="fas fa-spinner fa-spin mr-1"></i>Đang gửi…</p>

    <div class="split-layout" id="extractSplitLayout">
        <div class="split-pane-left mb-3 mb-lg-0">
            <div class="card-figma h-100">
                <div class="card-header-figma d-flex align-items-center justify-content-between flex-wrap">
                    <h3 class="card-title-figma mb-0">Tài liệu</h3>
                    @if (showPdfViewer)
                    {
                        <a href="@previewUrl" class="btn-figma btn-figma-outline btn-sm" target="_blank" rel="noopener">Mở toàn màn hình</a>
                    }
                </div>
                <div class="card-content-figma p-0">
                    @if (showPdfViewer)
                    {
                        <div class="border-bottom bg-light px-2 py-1 small text-muted">
                            @if (doc.OcrStatus == OcrStatus.SearchablePdfReady)
                            {
                                <span><i class="fas fa-copy mr-1"></i>PDF 2 lớp: chọn chữ trên tài liệu bên dưới, <strong>Ctrl+C</strong> rồi dán vào các ô nhập liệu.</span>
                            }
                            else if (!string.IsNullOrEmpty(spLabel))
                            {
                                <span>@spLabel — khi xong, làm tương tự để copy nhanh hơn.</span>
                            }
                            else
                            {
                                <span>Đang hiển thị bản scan. Sau khi hệ thống tạo PDF 2 lớp, bạn có thể copy chữ từ đây.</span>
                            }
                        </div>
                        <iframe src="@pdfViewerUrl" title="PDF tài liệu" class="w-100 border-0 d-block" style="min-height: 560px; height: calc(100vh - 280px);"></iframe>
                    }
                    else
                    {
                        <div class="p-3 text-muted small mb-0">Tài liệu không phải PDF — không có khung xem kèm.</div>
                    }
                </div>
            </div>
        </div>
        <div class="splitter" aria-hidden="true"></div>
        <div class="split-pane-right">
            <ul class="nav nav-tabs mb-3" id="extractTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="tab-info-link" data-toggle="tab" href="#tab-info" role="tab">Thông tin tài liệu</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="tab-same-record-link" data-toggle="tab" href="#tab-same-record" role="tab">Tài liệu cùng bộ</a>
                </li>
                <li class="nav-item">
                    <span class="nav-link disabled">Ghi chú</span>
                </li>
                <li class="nav-item">
                    <span class="nav-link disabled">Cá nhân xử lý</span>
                </li>
            </ul>

            <div class="tab-content" id="extractTabsContent">
                <div class="tab-pane fade show active" id="tab-info" role="tabpanel">
                    @{
                        var groupOrder = orderedFields
                            .GroupBy(f => f.GroupId)
                            .OrderBy(g => Model.FieldGroups.TryGetValue(g.Key, out var gr) ? gr.Weight : 999);
                    }
                    @foreach (var grp in groupOrder)
                    {
                        var gtitle = Model.FieldGroups.TryGetValue(grp.Key, out var g)
                            ? (string.IsNullOrEmpty(g.GroupName) ? g.Name : g.GroupName)
                            : (grp.Key == 0 ? "Trường thông tin" : $"Nhóm #{grp.Key}");
                        <div class="card-figma mb-3">
                            <div class="card-header-figma"><h3 class="card-title-figma mb-0">@gtitle</h3></div>
                            <div class="card-content-figma">
                                <div class="row">
                                    @foreach (var fs in grp.OrderBy(f => f.Weight))
                                    {
                                        <div class="col-md-6">
                                            <partial name="_FieldInput" model="(fs, Fv(fs))" />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (cells.Count > 0)
                    {
                        <div class="card-figma mb-3">
                            <div class="card-header-figma">
                                <h3 class="card-title-figma mb-0"><i class="fas fa-th mr-2" style="color:var(--primary);"></i>Ô nhập từ biểu mẫu / OCR</h3>
                            </div>
                            <div class="card-content-figma p-0">
                                <div class="table-container-figma mb-0" style="max-height:360px; overflow:auto;">
                                    <table class="table table-sm table-figma mb-0">
                                        <thead>
                                            <tr>
                                                <th>ID ô</th>
                                                <th>Tiêu đề</th>
                                                <th>Trang</th>
                                                <th>OCR / đã nhập</th>
                                                <th>Giá trị nhập</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var c in cells)
                                        {
                                            var showVal = string.IsNullOrEmpty(c.ExtractedValue) ? c.Value : c.ExtractedValue;
                                            <tr>
                                                <td><code>@c.Id</code></td>
                                                <td>@(c.Title ?? c.Field ?? "—")</td>
                                                <td>@c.Page</td>
                                                <td class="small text-muted text-truncate" style="max-width:180px;" title="@showVal">@showVal</td>
                                                <td style="min-width:200px;">
                                                    <input type="text" class="form-control form-control-sm ext-cell" data-cell-id="@c.Id" value="@c.ExtractedValue" placeholder="@c.Value" @(extractReadOnlyAfterCheck1Pass ? "readonly" : null) />
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="tab-pane fade" id="tab-same-record" role="tabpanel">
                    <div class="card-figma mb-3">
                        <div class="card-header-figma">
                            <h3 class="card-title-figma mb-0">Tài liệu cùng bộ hồ sơ</h3>
                        </div>
                        <div class="card-content-figma">
                            @if (sameRecordDocs.Count == 0)
                            {
                                <div class="alert alert-light border mb-0">Không có tài liệu cùng bộ hoặc chưa cấu hình <code>SetRecordInfo</code>.</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width:40px;">STT</th>
                                                <th>Phiếu</th>
                                                <th style="width:90px;">Đã nhận</th>
                                                <th style="width:130px;">Trạng thái</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @{
                                            var rowNo = 1;
                                            foreach (var sdoc in sameRecordDocs)
                                            {
                                                var isCurrent = sdoc.Id == doc.Id;
                                                var isEligibleForExtract = (!requireCheckFirstScan || sdoc.IsCheckedScan1)
                                                    && (!requireCheckSecondScan || sdoc.IsCheckedScan2);
                                                <tr>
                                                    <td>@rowNo</td>
                                                    <td>
                                                        @if (isCurrent)
                                                        {
                                                            <span class="text-danger font-weight-bold">@((sdoc.FileName ?? sdoc.Name) ?? $"#{sdoc.Id}")</span>
                                                        }
                                                        else
                                                        {
                                                            <a asp-area="sohoa" asp-controller="Extract" asp-action="Form" asp-route-id="@sdoc.Id">
                                                                @((sdoc.FileName ?? sdoc.Name) ?? $"#{sdoc.Id}")
                                                            </a>
                                                        }
                                                    </td>
                                                    <td class="text-center">@(sdoc.ExtractedBy > 0 || isCurrent ? "✔" : "")</td>
                                                    <td>
                                                        @if (isCurrent)
                                                        {
                                                            <span class="badge badge-info">Đang nhập</span>
                                                        }
                                                        else if (sdoc.IsExtracted)
                                                        {
                                                            <span class="badge badge-success">Đã nhập</span>
                                                        }
                                                        else if (!isEligibleForExtract)
                                                        {
                                                            <span class="badge badge-secondary">Không đủ điều kiện</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">Chưa nhập</span>
                                                        }
                                                    </td>
                                                </tr>
                                                rowNo++;
                                            }
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="antiEx" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script src="~/js/shtl-ajax.js" asp-append-version="true"></script>
    <script>
        (function () {
            var submitUrl = @Html.Raw(JsonSerializer.Serialize(submitUrl));
            var docId = @doc.Id;
            initSplitLayout('extractSplitLayout');

            function initSplitLayout(layoutId) {
                var layout = document.getElementById(layoutId);
                if (!layout) return;
                var leftPane = layout.querySelector('.split-pane-left');
                var splitter = layout.querySelector('.splitter');
                if (!leftPane || !splitter) return;

                var dragging = false;
                var startX = 0;
                var startWidth = 0;
                var blockedIframes = [];

                splitter.addEventListener('mousedown', function (e) {
                    if (window.innerWidth < 992) return;
                    dragging = true;
                    startX = e.clientX;
                    startWidth = leftPane.getBoundingClientRect().width;
                    blockedIframes = Array.prototype.slice.call(layout.querySelectorAll('iframe'));
                    blockedIframes.forEach(function (f) { f.style.pointerEvents = 'none'; });
                    splitter.classList.add('is-dragging');
                    document.body.style.cursor = 'col-resize';
                    document.body.style.userSelect = 'none';
                    e.preventDefault();
                });

                window.addEventListener('mousemove', function (e) {
                    if (!dragging) return;
                    var dx = e.clientX - startX;
                    var newWidth = startWidth + dx;
                    var total = layout.getBoundingClientRect().width;
                    var minWidth = 320;
                    var maxWidth = Math.max(minWidth, total - 360 - 10);
                    newWidth = Math.max(minWidth, Math.min(maxWidth, newWidth));
                    var percent = (newWidth / total) * 100;
                    leftPane.style.flexBasis = percent.toFixed(2) + '%';
                });

                window.addEventListener('mouseup', function () {
                    if (!dragging) return;
                    dragging = false;
                    blockedIframes.forEach(function (f) { f.style.pointerEvents = ''; });
                    blockedIframes = [];
                    splitter.classList.remove('is-dragging');
                    document.body.style.cursor = '';
                    document.body.style.userSelect = '';
                });
            }

            function token() {
                return window.ShtlAjax.getRequestVerificationToken();
            }

            function toastErrorLong(msg) {
                if (typeof toastr !== 'undefined') {
                    toastr.error(msg, '', { timeOut: 90000, closeButton: true, tapToDismiss: true, newestOnTop: true });
                } else {
                    alert(msg);
                }
            }

            document.getElementById('btnExtractSubmit').onclick = function () {
                var submitBtn = document.getElementById('btnExtractSubmit');
                if (submitBtn.getAttribute('data-can-submit') !== 'true') {
                    toastErrorLong(submitBtn.getAttribute('data-block-reason') || 'Tài liệu chưa đủ điều kiện nhập liệu.');
                    return;
                }
                var stg = {};
                document.querySelectorAll('[data-stg-field]').forEach(function (el) {
                    var k = el.getAttribute('data-stg-field');
                    if (k) stg[k] = el.value;
                });
                var cells = [];
                document.querySelectorAll('.ext-cell[data-cell-id]').forEach(function (el) {
                    var id = parseInt(el.getAttribute('data-cell-id'), 10);
                    if (id) cells.push({ id: id, value: el.value });
                });
                var body = { documentId: docId, cells: cells, stgFieldValues: stg };
                for (var n = 9; n <= 15; n++) {
                    var key = 'field' + n;
                    if (stg[key] !== undefined && stg[key] !== '') body[key] = stg[key];
                }
                var hint = document.getElementById('extract-submit-hint');
                hint.classList.remove('d-none');
                fetch(submitUrl, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token()
                    },
                    body: JSON.stringify(body)
                }).then(function (r) {
                    return r.text().then(function (text) {
                        return { ok: r.ok, status: r.status, text: text };
                    });
                }).then(function (res) {
                    hint.classList.add('d-none');
                    var j = null;
                    try {
                        j = res.text ? JSON.parse(res.text) : null;
                    } catch (e) {
                        j = null;
                    }
                    if (!res.ok) {
                        var msg = (j && j.message) ? j.message : ('HTTP ' + res.status);
                        if (!j && res.text) {
                            var t = res.text.replace(/<[^>]+>/g, ' ').trim();
                            if (t.length > 220) t = t.substring(0, 220) + '…';
                            if (t) msg += ' — ' + t;
                        }
                        if (res.status === 400 && !j) msg = 'Phiên hết hạn hoặc lỗi bảo mật (antiforgery). Tải lại trang rồi thử lưu.';
                        toastErrorLong(msg);
                        return;
                    }
                    if (!j) {
                        toastErrorLong('Phản hồi không hợp lệ từ server.');
                        return;
                    }
                    if (j.success) {
                        if (typeof toastr !== 'undefined') toastr.success(j.message || 'Đã lưu');
                        window.location.href = @Html.Raw(JsonSerializer.Serialize(indexUrl));
                    } else {
                        toastErrorLong(j.message || 'Lỗi');
                    }
                }).catch(function (err) {
                    hint.classList.add('d-none');
                    var msg = 'Lỗi mạng hoặc trình duyệt chặn yêu cầu.';
                    if (err && err.message) msg += ' ' + err.message;
                    toastErrorLong(msg);
                });
            };
        })();
    </script>
}
