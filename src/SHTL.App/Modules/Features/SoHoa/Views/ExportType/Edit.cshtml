@model UpdateExportTypeRequest
@{ ViewData["Title"] = "Sửa loại xuất"; }
@section Breadcrumb { <li class="breadcrumb-item"><a asp-area="sohoa" asp-controller="ExportType" asp-action="Index">Loại xuất</a></li><li class="breadcrumb-item active">Sửa</li> }
<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:36px;height:36px;background:var(--primary-light);color:var(--primary);border-radius:8px;"><i class="fas fa-file-export"></i></div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Sửa loại xuất</h6>
                    <div class="text-muted small">Cập nhật cấu hình và file mẫu Excel.</div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-figma">
        <div class="card-content-figma">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <form asp-area="sohoa" asp-controller="ExportType" asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="form-group-figma">
                    <label asp-for="Name" class="label-figma"></label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="form-group-figma">
                    <label asp-for="Code" class="label-figma"></label>
                    <input asp-for="Code" class="form-control" />
                </div>
                <div class="form-group-figma">
                    <label asp-for="Description" class="label-figma"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="custom-control custom-checkbox mb-3">
                    <input asp-for="IsActive" class="custom-control-input" id="expActive" />
                    <label asp-for="IsActive" class="custom-control-label" for="expActive"></label>
                </div>
                <div class="form-group-figma">
                    <label class="label-figma">Excel mới (tuỳ chọn)</label>
                    <input type="file" name="excelFile" class="form-control-file" accept=".xlsx,.xls" />
                </div>
                @if (!string.IsNullOrEmpty(Model.ExcelFileName))
                {
                    <p class="small text-muted">File hiện tại: @Model.ExcelFileName</p>
                }
                <div class="d-flex flex-wrap" style="gap:8px;">
                    <button type="submit" class="btn-figma btn-figma-primary">Cập nhật</button>
                    <a asp-area="sohoa" asp-controller="ExportType" asp-action="Index" class="btn-figma btn-figma-outline">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
