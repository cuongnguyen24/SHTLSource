@model SyncTypeEditPageDto
@if (Model.CategoryTypes.Count == 0)
{
    <p class="text-muted small mb-0">Không có danh mục.</p>
}
else
{
    foreach (var cat in Model.CategoryTypes)
    {
        var st = Model.Settings.FirstOrDefault(x => x.IsCatalog && x.IdField == cat.Id);
        <div class="border-bottom py-2">
            <div class="custom-control custom-checkbox mb-2">
                <input type="checkbox" class="custom-control-input" id="sc_@cat.Id" name="CT@(cat.Id)" value="true" @(st != null ? "checked" : null) />
                <label class="custom-control-label" for="sc_@cat.Id"><strong>@cat.Name</strong></label>
            </div>
            <div class="form-row small">
                <div class="col-md-4"><label class="mb-0 text-muted">Tiêu đề</label><input class="form-control form-control-sm" name="CTN@(cat.Id)" value="@(st?.Title ?? cat.Name)" /></div>
                <div class="col-md-3"><label class="mb-0 text-muted">Pattern</label><select class="form-control form-control-sm" name="CTPT@(cat.Id)"><option value="0">—</option>@foreach (var p in Model.PatternTypes) { if (st?.IdPatternType == p.Id) { <option value="@p.Id" selected="selected">@p.Name</option> } else { <option value="@p.Id">@p.Name</option> } }</select></div>
                <div class="col-md-2"><label class="mb-0 text-muted">MinL</label><input type="number" class="form-control form-control-sm" name="CTMinL@(cat.Id)" value="@st?.MinLen" /></div>
                <div class="col-md-2"><label class="mb-0 text-muted">MaxL</label><input type="number" class="form-control form-control-sm" name="CTMaxL@(cat.Id)" value="@st?.MaxLen" /></div>
            </div>
            <div class="form-row small mt-1">
                <div class="col-md-3"><label class="mb-0 text-muted">Fix</label><input class="form-control form-control-sm" name="CTFixV@(cat.Id)" value="@st?.FixValue" /></div>
                <div class="col-md-3"><label class="mb-0 text-muted">Min/Max</label><div class="d-flex" style="gap:4px;"><input class="form-control form-control-sm" name="CTMinV@(cat.Id)" value="@st?.MinValue" /><input class="form-control form-control-sm" name="CTMaxV@(cat.Id)" value="@st?.MaxValue" /></div></div>
                <div class="col-md-6"><label class="mb-0 text-muted">Custom</label><input class="form-control form-control-sm" name="CTPC@(cat.Id)" value="@st?.PatternCustom" /></div>
            </div>
        </div>
    }
}
