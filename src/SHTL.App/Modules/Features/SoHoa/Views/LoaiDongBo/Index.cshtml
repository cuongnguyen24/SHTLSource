@model IReadOnlyList<DocTypeSyncListItemDto>
@{
    ViewData["Title"] = "Loại đồng bộ";
    var search = ViewBag.Search as string ?? "";
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-area="sohoa" asp-controller="Home" asp-action="Index">Tổng quan</a></li>
    <li class="breadcrumb-item active">Loại đồng bộ</li>
}
@section Styles {
    <style>
        .sync-table tbody tr:hover {
            background-color: #f9f9f9;
        }
        .action-btn {
            padding: 4px 8px;
            margin: 0 2px;
            font-size: 12px;
        }
        .action-btn i {
            margin-right: 0;
        }
    </style>
}

<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:var(--primary-light);color:var(--primary);border-radius:6px;"><i class="fas fa-sync-alt"></i></div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Loại đồng bộ</h6>
                    <div class="text-muted small">Cấu hình đồng bộ theo loại tài liệu</div>
                </div>
            </div>
            <a asp-area="sohoa" asp-controller="LoaiDongBo" asp-action="Create" class="btn-figma btn-figma-primary btn-sm"><i class="fas fa-plus mr-1"></i>Tạo mới</a>
        </div>
    </div>
    <div class="frame-figma frame-figma-combined">
        <div class="frame-filter">
            <form method="get" class="d-flex align-items-center flex-wrap" style="gap:8px;">
                <div class="search-input-figma" style="min-width:260px;">
                    <input type="text" name="q" value="@search" placeholder="Tìm kiếm…" />
                    <i class="fas fa-search search-icon"></i>
                </div>
                <button type="submit" class="btn-figma btn-figma-primary">Tìm</button>
            </form>
        </div>
        <div class="p-3">
            @if (Model.Count == 0)
            {
                <div class="alert alert-light border mb-0">Chưa có bản ghi.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover sync-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40px;">STT</th>
                                <th>Tên</th>
                                <th>Mô tả</th>
                                <th>Cấu trúc thư mục</th>
                                <th style="width: 200px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">@stt</td>
                                        <td><strong>@item.Name</strong></td>
                                        <td><small class="text-muted">@(item.Describe ?? "—")</small></td>
                                        <td><small class="text-muted">@(item.Format ?? "—")</small></td>
                                        <td>
                                            <a href="@Url.Action("Edit", "LoaiDongBo", new { area = "sohoa", id = item.Id })" 
                                               class="btn btn-sm btn-outline-primary action-btn">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="@Url.Action("Clone", "LoaiDongBo", new { area = "sohoa", id = item.Id })" 
                                               class="btn btn-sm btn-outline-info action-btn" onclick="return confirm('Bạn có chắc muốn sao chép?')">
                                                <i class="fas fa-copy"></i>
                                            </a>
                                            <form method="post" action="@Url.Action("Delete", "LoaiDongBo", new { area = "sohoa", id = item.Id })" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger action-btn" onclick="return confirm('Bạn có chắc muốn xóa?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    stt++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
