@model SyncTypeEditPageDto
@* Trường mặc định (Hiển thị) — không cần cấu hình chi tiết ở Loại đồng bộ. *@

@{
    string GetInputTypeString(int inputTypeId)
    {
        return inputTypeId switch
        {
            1 => "text",
            2 => "textarea",
            3 => "number",
            4 => "date",
            5 => "select",
            _ => "text"
        };
    }
    string GetDbStorageColumn(int fieldId, string fallback)
    {
        return fieldId switch
        {
            1 => "file_name",
            2 => "symbol_no",
            3 => "issued_by",
            4 => "receiver",
            5 => "subject",
            6 => "level_no",
            7 => "box_no",
            8 => "record_no",
            9 => "record_title",
            10 => "poster",
            11 => "signer",
            12 => "slot_no",
            13 => "shelf_no",
            14 => "noted",
            _ => fallback
        };
    }
}

<div class="default-fields-container">
    <div class="row">
        @{
            var defaultFields = new List<(int id, string name, string title)>
            {
                (1, "title", "Tên"),
                (2, "symbolno", "Số ký hiệu"),
                (3, "issuer", "Cơ quan ban hành"),
                (4, "receiver", "Nơi nhận"),
                (5, "subject", "Về việc"),
                (6, "levelno", "Tầng số"),
                (7, "boxno", "Hộp số"),
                (8, "recordno", "Hồ sơ số"),
                (9, "recordtitle", "Tiêu đề hồ sơ"),
                (10, "poster", "Người lập"),
                (11, "signer", "Người ký"),
                (12, "slotno", "Khoang số"),
                (13, "shelfno", "Giá / kệ số"),
                (14, "noted", "Ghi chú")
            };

            var midPoint = (defaultFields.Count + 1) / 2;
            var leftFields = defaultFields.Take(midPoint).ToList();
            var rightFields = defaultFields.Skip(midPoint).ToList();
        }

        @foreach (var group in new[] { ("defaultFieldsBodyLeft", leftFields), ("defaultFieldsBodyRight", rightFields) })
        {
            <div class="col-md-6">
                <div class="table-container-figma mb-0" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-sm table-figma mb-0">
                        <thead>
                            <tr>
                                <th style="width: 48px;">Dùng</th>
                                <th>Tên trường hiển thị / Lưu DB</th>
                            </tr>
                        </thead>
                        <tbody id="@group.Item1">
                            @foreach (var field in group.Item2)
                            {
                                var st = Model.Settings.FirstOrDefault(s => s.IdField == field.id && !s.IsCatalog);
                                var isEnabled = st != null;
                                var weight = st?.Weight ?? (field.id * 10);
                                var inputType = GetInputTypeString(st?.IType ?? 1);
                                var fieldGroup = st?.IdFieldGroup ?? 0;
                                var fieldTitle = st?.Title ?? field.title;
                                var description = st?.PatternCustom ?? "";
                                var defaultValue = st?.FixValue ?? "";
                                var patternId = st?.IdPatternType ?? 0;
                                var minValue = st?.MinValue ?? "";
                                var maxValue = st?.MaxValue ?? "";
                                var minLen = st?.MinLen ?? 0;
                                var maxLen = st?.MaxLen ?? 0;
                                var requiredValue = st?.IsRequired == true ? "true" : "false";
                                var readOnlyValue = st?.IsReadOnly == true ? "true" : "false";
                                var upperCaseValue = st?.IsUpperCase == true ? "true" : "false";
                                var capitalizeValue = st?.IsCapitalize == true ? "true" : "false";
                                var dbColumn = GetDbStorageColumn(field.id, field.name);

                                <tr class="default-field-row" data-field-id="@field.id" data-weight="@weight">
                                    <td>
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input field-enabled"
                                                   id="df_@(field.id)" name="DF@(field.id)" value="true"
                                                   @(isEnabled ? "checked" : null) />
                                            <label class="custom-control-label" for="df_@(field.id)"></label>
                                            <input type="hidden" name="DF_Enabled_@(field.id)" value="@(isEnabled ? "true" : "false")" class="field-enabled-hidden" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center" style="gap:8px;">
                                            <input type="text" class="form-control form-control-sm field-title"
                                                   name="DF_Title_@(field.id)" value="@fieldTitle"
                                                   placeholder="@field.title" />
                                            <input type="text" class="form-control form-control-sm bg-light text-muted"
                                                   value="@dbColumn" readonly title="Cột lưu dữ liệu trong bảng documents" />
                                        </div>
                                        <input type="hidden" name="DF_Weight_@(field.id)" value="@weight" class="field-weight" />
                                        <input type="hidden" name="DF_InputType_@(field.id)" value="@inputType" />
                                        <input type="hidden" name="DF_GroupDetail_@(field.id)" value="@fieldGroup" />
                                        <input type="hidden" name="DF_Description_@(field.id)" value="@description" />
                                        <input type="hidden" name="DF_DefaultValue_@(field.id)" value="@defaultValue" />
                                        <input type="hidden" name="DF_Pattern_@(field.id)" value="@patternId" />
                                        <input type="hidden" name="DF_MinValue_@(field.id)" value="@minValue" />
                                        <input type="hidden" name="DF_MaxValue_@(field.id)" value="@maxValue" />
                                        <input type="hidden" name="DF_MinLen_@(field.id)" value="@minLen" />
                                        <input type="hidden" name="DF_MaxLen_@(field.id)" value="@maxLen" />
                                        <input type="hidden" name="DF_Required_@(field.id)" value="@requiredValue" />
                                        <input type="hidden" name="DF_ReadOnly_@(field.id)" value="@readOnlyValue" />
                                        <input type="hidden" name="DF_UpperCase_@(field.id)" value="@upperCaseValue" />
                                        <input type="hidden" name="DF_Capitalize_@(field.id)" value="@capitalizeValue" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

<style>
.default-fields-container {
    margin-bottom: 20px;
}

.default-field-row.disabled {
    opacity: 0.6;
}

.default-field-row.disabled input,
.default-field-row.disabled select {
    background-color: #f0f0f0;
    cursor: not-allowed;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // Toggle field enabled/disabled state
    document.querySelectorAll('.default-field-row .field-enabled').forEach(checkbox => {
        checkbox.addEventListener('change', function () {
            const row = this.closest('tr');
            const enabledHidden = row ? row.querySelector('.field-enabled-hidden') : null;
            if (this.checked) {
                row.classList.remove('disabled');
                if (enabledHidden) enabledHidden.value = 'true';
            } else {
                row.classList.add('disabled');
                if (enabledHidden) enabledHidden.value = 'false';
            }
        });
    });
});
</script>
