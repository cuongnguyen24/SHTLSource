@model DocTypeEditPageDto
@* Trường danh mục (catalog) — key CT{id}, CTIsCatalogMain. *@
@if (Model.CategoryTypes.Count == 0)
{
    <p class="text-muted small mb-0">Không có nhóm danh mục.</p>
}
else
{
    var mainId = Model.Settings.FirstOrDefault(s => s.IsCatalogMain)?.IdCategoryType ?? 0;
    <div class="table-container-figma mb-0">
        <table class="table table-sm table-figma mb-0">
            <thead>
                <tr>
                    <th style="width:48px;">Dùng</th>
                    <th>Danh mục</th>
                    <th>Tiêu đề (CTN)</th>
                    <th style="width:64px;">Multi</th>
                    <th style="width:72px;">Pattern</th>
                    <th style="width:56px;">Chính</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var cat in Model.CategoryTypes)
            {
                var st = Model.Settings.FirstOrDefault(s => s.IsCatalog && s.IdField == cat.Id);
                var on = st != null;
                <tr>
                    <td>
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="ct_@cat.Id" name="CT@(cat.Id)" value="true" @(on ? "checked" : null) />
                            <label class="custom-control-label" for="ct_@cat.Id"></label>
                        </div>
                    </td>
                    <td><small>@cat.Name</small></td>
                    <td><input type="text" class="form-control form-control-sm" name="CTN@(cat.Id)" value="@(st?.Title ?? cat.Name)" /></td>
                    <td class="text-center"><input type="checkbox" name="CTIsMulti@(cat.Id)" value="true" @(st?.IsMulti == true ? "checked" : null) /></td>
                    <td>
                        <select class="form-control form-control-sm" name="CTPT@(cat.Id)">
                            <option value="0">—</option>
                            @foreach (var p in Model.PatternTypes)
                            {
                                if (st?.IdPatternType == p.Id)
                                { <option value="@p.Id" selected="selected">@p.Name</option> }
                                else
                                { <option value="@p.Id">@p.Name</option> }
                            }
                        </select>
                    </td>
                    <td class="text-center">
                        <input type="radio" name="CTIsCatalogMain" value="@cat.Id" @(mainId == cat.Id ? "checked" : null) />
                    </td>
                </tr>
                <tr class="bg-light">
                    <td colspan="6" class="py-2">
                        <div class="form-row small">
                            <div class="col-md-3"><label class="mb-0 text-muted">Fix</label><input class="form-control form-control-sm" name="CTFixV@(cat.Id)" value="@st?.FixValue" /></div>
                            <div class="col-md-3"><label class="mb-0 text-muted">Min/Max</label><div class="d-flex" style="gap:4px;"><input type="number" step="any" inputmode="decimal" class="form-control form-control-sm" name="CTMinV@(cat.Id)" value="@st?.MinValue" /><input type="number" step="any" inputmode="decimal" class="form-control form-control-sm" name="CTMaxV@(cat.Id)" value="@st?.MaxValue" /></div></div>
                            <div class="col-md-2"><label class="mb-0 text-muted">Len</label><div class="d-flex" style="gap:4px;"><input type="number" class="form-control form-control-sm" name="CTMinL@(cat.Id)" value="@st?.MinLen" /><input type="number" class="form-control form-control-sm" name="CTMaxL@(cat.Id)" value="@st?.MaxLen" /></div></div>
                            <div class="col-md-2"><label class="mb-0 text-muted">Nhóm</label><select class="form-control form-control-sm" name="CTG@(cat.Id)"><option value="0">—</option>@foreach (var g in Model.FieldGroups) { if (st?.IdFieldGroup == g.Id) { <option value="@g.Id" selected="selected">@g.Name</option> } else { <option value="@g.Id">@g.Name</option> } }</select></div>
                            <div class="col-md-2"><label class="mb-0 text-muted">Custom</label><input class="form-control form-control-sm" name="CTPC@(cat.Id)" value="@st?.PatternCustom" /></div>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
