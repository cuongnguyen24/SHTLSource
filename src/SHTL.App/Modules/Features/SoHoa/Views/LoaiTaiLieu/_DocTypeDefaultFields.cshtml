@model DocTypeEditPageDto
@* Trường mặc định (Hiển thị) — các trường chuẩn như Tên, Mô tả, Số ký hiệu, v.v. *@

@{
    string GetInputTypeString(int inputTypeId)
    {
        return inputTypeId switch
        {
            1 => "text",
            2 => "textarea",
            3 => "number",
            4 => "date",
            5 => "select",
            6 => "radio",
            7 => "checkbox",
            _ => "text"
        };
    }
}

<div class="default-fields-container">
    <div class="row">
        @{
            // Danh sách trường mặc định chuẩn
            var defaultFields = new List<(int id, string name, string title)>
            {
                (1, "dc_title", "Tên"),
                (2, "dc_symbol", "Số ký hiệu"),
                (3, "dc_receiver", "Nơi nhận"),
                (4, "dc_box", "Hộp"),
                (5, "dc_num1", "Số nguyên mẫu"),
                (6, "dc_date1", "Ngày tháng mẫu"),
                (7, "dc_custom1", "Tùy chỉnh"),
                (8, "dc_select1", "Chọn"),
                (9, "fc_title", "Tiêu đề hồ sơ"),
                (10, "fc_end", "Thời gian kết thúc"),
                (11, "fc_lang", "Ngôn ngữ"),
                (12, "fc_start", "Thời gian bắt đầu"),
                (13, "fc_pages", "Số lượng tờ"),
                (14, "fc_store", "Thời hạn lưu trữ"),
                (15, "fc_dec1", "Số thập phân"),
                (16, "fc_date1", "Ngày mở rộng"),
                (17, "std_text", "Trường text chuẩn"),
                (18, "std_num", "Số nguyên chuẩn"),
                (19, "std_dec", "Số thập phân chuẩn"),
                (20, "std_date", "Ngày chuẩn")
            };

            var midPoint = (defaultFields.Count + 1) / 2;
            var leftFields = defaultFields.Take(midPoint).ToList();
            var rightFields = defaultFields.Skip(midPoint).ToList();
        }

        <!-- Cột trái -->
        <div class="col-md-6">
            <div class="table-container-figma mb-0" style="max-height: 500px; overflow-y: auto;">
                <table class="table table-sm table-figma mb-0">
                    <thead>
                        <tr>
                            <th style="width: 48px;">Dùng</th>
                            <th>Tên trường</th>
                            <th style="width: 60px;">Cấu hình</th>
                        </tr>
                    </thead>
                    <tbody id="defaultFieldsBodyLeft">
                        @{
                            var stt = 1;
                            foreach (var field in leftFields)
                            {
                                var st = Model.Settings.FirstOrDefault(s => s.IdField == field.id && !s.IsCatalog);
                                var isEnabled = st != null;
                                var weight = st?.Weight ?? (stt * 10);
                                var inputType = GetInputTypeString(st?.IType ?? 1);
                                var fieldGroup = st?.IdFieldGroup ?? 0;
                                var fieldTitle = st?.Title ?? field.title;

                                <tr class="default-field-row" data-field-id="@field.id" data-weight="@weight">
                                    <td>
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input field-enabled" 
                                                   id="df_@(field.id)" name="DF@(field.id)" value="true" 
                                                   @(isEnabled ? "checked" : null) />
                                            <label class="custom-control-label" for="df_@(field.id)"></label>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm field-title" 
                                               name="DF_Title_@(field.id)" value="@fieldTitle" 
                                               placeholder="@field.title" />
                                        <input type="hidden" name="DF_Weight_@(field.id)" value="@weight" class="field-weight" />
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-secondary field-config-btn" 
                                                data-field-id="@field.id" data-field-name="@field.title" 
                                                data-input-type="@inputType" data-field-group="@fieldGroup"
                                                title="Cấu hình chi tiết">
                                            <i class="fas fa-cog"></i>
                                        </button>
                                    </td>
                                </tr>
                                stt++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Cột phải -->
        <div class="col-md-6">
            <div class="table-container-figma mb-0" style="max-height: 500px; overflow-y: auto;">
                <table class="table table-sm table-figma mb-0">
                    <thead>
                        <tr>
                            <th style="width: 48px;">Dùng</th>
                            <th>Tên trường</th>
                            <th style="width: 60px;">Cấu hình</th>
                        </tr>
                    </thead>
                    <tbody id="defaultFieldsBodyRight">
                        @{
                            foreach (var field in rightFields)
                            {
                                var st = Model.Settings.FirstOrDefault(s => s.IdField == field.id && !s.IsCatalog);
                                var isEnabled = st != null;
                                var weight = st?.Weight ?? (stt * 10);
                                var inputType = GetInputTypeString(st?.IType ?? 1);
                                var fieldGroup = st?.IdFieldGroup ?? 0;
                                var fieldTitle = st?.Title ?? field.title;

                                <tr class="default-field-row" data-field-id="@field.id" data-weight="@weight">
                                    <td>
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input field-enabled" 
                                                   id="df_@(field.id)" name="DF@(field.id)" value="true" 
                                                   @(isEnabled ? "checked" : null) />
                                            <label class="custom-control-label" for="df_@(field.id)"></label>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm field-title" 
                                               name="DF_Title_@(field.id)" value="@fieldTitle" 
                                               placeholder="@field.title" />
                                        <input type="hidden" name="DF_Weight_@(field.id)" value="@weight" class="field-weight" />
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-secondary field-config-btn" 
                                                data-field-id="@field.id" data-field-name="@field.title" 
                                                data-input-type="@inputType" data-field-group="@fieldGroup"
                                                title="Cấu hình chi tiết">
                                            <i class="fas fa-cog"></i>
                                        </button>
                                    </td>
                                </tr>
                                stt++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal cấu hình chi tiết -->
<div class="modal fade" id="fieldConfigModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cấu hình trường: <span id="modalFieldName"></span></h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalFieldId" />
                <div class="form-row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Kiểu nhập</label>
                            <select class="form-control" id="modalInputType">
                                <option value="text">Text</option>
                                <option value="textarea">Textarea</option>
                                <option value="number">Number</option>
                                <option value="date">Date</option>
                                <option value="select">Select</option>
                                <option value="radio">Radio</option>
                                <option value="checkbox">Checkbox</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Nhóm trường</label>
                            <select class="form-control" id="modalFieldGroup">
                                <option value="0">—</option>
                                @foreach (var g in Model.FieldGroups)
                                {
                                    <option value="@g.Id">@g.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label>Mô tả / Ghi chú</label>
                    <textarea class="form-control" id="modalDescription" rows="2"></textarea>
                </div>
                <div class="form-row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Giá trị mặc định</label>
                            <input type="text" class="form-control" id="modalDefaultValue" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Quy tắc</label>
                            <select class="form-control" id="modalPattern">
                                <option value="0">—</option>
                                @foreach (var p in Model.PatternTypes)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="col-md-6">
                        <label>Min / Max giá trị</label>
                        <div class="d-flex" style="gap: 8px;">
                            <input type="text" class="form-control" id="modalMinValue" placeholder="Min" />
                            <input type="text" class="form-control" id="modalMaxValue" placeholder="Max" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label>Min / Max độ dài</label>
                        <div class="d-flex" style="gap: 8px;">
                            <input type="number" class="form-control" id="modalMinLen" placeholder="Min" />
                            <input type="number" class="form-control" id="modalMaxLen" placeholder="Max" />
                        </div>
                    </div>
                </div>
                <div class="form-row mt-3">
                    <div class="col-auto">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="modalRequired" />
                            <label class="custom-control-label" for="modalRequired">Bắt buộc</label>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="modalReadOnly" />
                            <label class="custom-control-label" for="modalReadOnly">Chỉ đọc</label>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="modalUpperCase" />
                            <label class="custom-control-label" for="modalUpperCase">Viết hoa</label>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="modalCapitalize" />
                            <label class="custom-control-label" for="modalCapitalize">Capitalize</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="saveFieldConfig">Lưu cấu hình</button>
            </div>
        </div>
    </div>
</div>

<style>
.default-fields-container {
    margin-bottom: 20px;
}

.field-config-btn {
    padding: 4px 8px;
    font-size: 12px;
}

.field-config-btn:hover {
    background-color: #e2e6ea;
}

.default-field-row.disabled {
    opacity: 0.6;
}

.default-field-row.disabled input,
.default-field-row.disabled select {
    background-color: #f0f0f0;
    cursor: not-allowed;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize Bootstrap tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });

    // Toggle field enabled/disabled state
    document.querySelectorAll('.field-enabled').forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            const row = this.closest('tr');
            if (this.checked) {
                row.classList.remove('disabled');
            } else {
                row.classList.add('disabled');
            }
        });
    });

    // Open config modal
    document.querySelectorAll('.field-config-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const fieldId = this.getAttribute('data-field-id');
            const fieldName = this.getAttribute('data-field-name');
            const inputType = this.getAttribute('data-input-type') || 'text';
            const fieldGroup = this.getAttribute('data-field-group') || '0';
            
            // Set modal data
            document.getElementById('modalFieldId').value = fieldId;
            document.getElementById('modalFieldName').textContent = fieldName;
            document.getElementById('modalInputType').value = inputType;
            document.getElementById('modalFieldGroup').value = fieldGroup;
            
            // Load existing values from hidden inputs if any
            const prefix = 'DF_';
            document.getElementById('modalDescription').value = document.querySelector(`[name="${prefix}Description_${fieldId}"]`)?.value || '';
            document.getElementById('modalDefaultValue').value = document.querySelector(`[name="${prefix}DefaultValue_${fieldId}"]`)?.value || '';
            document.getElementById('modalPattern').value = document.querySelector(`[name="${prefix}Pattern_${fieldId}"]`)?.value || '0';
            document.getElementById('modalMinValue').value = document.querySelector(`[name="${prefix}MinValue_${fieldId}"]`)?.value || '';
            document.getElementById('modalMaxValue').value = document.querySelector(`[name="${prefix}MaxValue_${fieldId}"]`)?.value || '';
            document.getElementById('modalMinLen').value = document.querySelector(`[name="${prefix}MinLen_${fieldId}"]`)?.value || '';
            document.getElementById('modalMaxLen').value = document.querySelector(`[name="${prefix}MaxLen_${fieldId}"]`)?.value || '';
            document.getElementById('modalRequired').checked = document.querySelector(`[name="${prefix}Required_${fieldId}"]`)?.checked || false;
            document.getElementById('modalReadOnly').checked = document.querySelector(`[name="${prefix}ReadOnly_${fieldId}"]`)?.checked || false;
            document.getElementById('modalUpperCase').checked = document.querySelector(`[name="${prefix}UpperCase_${fieldId}"]`)?.checked || false;
            document.getElementById('modalCapitalize').checked = document.querySelector(`[name="${prefix}Capitalize_${fieldId}"]`)?.checked || false;
            
            $('#fieldConfigModal').modal('show');
        });
    });

    // Save config
    document.getElementById('saveFieldConfig').addEventListener('click', function() {
        const fieldId = document.getElementById('modalFieldId').value;
        const prefix = 'DF_';
        
        // Create or update hidden inputs
        const form = document.querySelector('form');
        const fields = {
            [`${prefix}InputType_${fieldId}`]: document.getElementById('modalInputType').value,
            [`${prefix}GroupDetail_${fieldId}`]: document.getElementById('modalFieldGroup').value,
            [`${prefix}Description_${fieldId}`]: document.getElementById('modalDescription').value,
            [`${prefix}DefaultValue_${fieldId}`]: document.getElementById('modalDefaultValue').value,
            [`${prefix}Pattern_${fieldId}`]: document.getElementById('modalPattern').value,
            [`${prefix}MinValue_${fieldId}`]: document.getElementById('modalMinValue').value,
            [`${prefix}MaxValue_${fieldId}`]: document.getElementById('modalMaxValue').value,
            [`${prefix}MinLen_${fieldId}`]: document.getElementById('modalMinLen').value,
            [`${prefix}MaxLen_${fieldId}`]: document.getElementById('modalMaxLen').value
        };
        
        Object.keys(fields).forEach(name => {
            let input = form.querySelector(`[name="${name}"]`);
            if (!input) {
                input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                form.appendChild(input);
            }
            input.value = fields[name];
        });
        
        // Handle checkboxes
        const checkboxes = {
            [`${prefix}Required_${fieldId}`]: document.getElementById('modalRequired').checked,
            [`${prefix}ReadOnly_${fieldId}`]: document.getElementById('modalReadOnly').checked,
            [`${prefix}UpperCase_${fieldId}`]: document.getElementById('modalUpperCase').checked,
            [`${prefix}Capitalize_${fieldId}`]: document.getElementById('modalCapitalize').checked
        };
        
        Object.keys(checkboxes).forEach(name => {
            let input = form.querySelector(`[name="${name}"]`);
            if (checkboxes[name]) {
                if (!input) {
                    input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = name;
                    input.value = 'true';
                    form.appendChild(input);
                }
            } else {
                if (input) input.remove();
            }
        });
        
        $('#fieldConfigModal').modal('hide');
        alert('Đã lưu cấu hình!');
    });
});
</script>
