@model DocTypeSeparatePageDto
@{
    ViewData["Title"] = "Phân tách trang";
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-area="sohoa" asp-controller="LoaiTaiLieu" asp-action="Index">Loại tài liệu</a></li>
    <li class="breadcrumb-item active">Phân tách trang</li>
}

<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div>
                <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">@Model.DocType.Name</h6>
                <div class="text-muted small">Mỗi vùng: X, Y, Width, Height (pixel). Lưu gửi list <code>X,Y,W,H</code> qua form.</div>
            </div>
            <a asp-area="sohoa" asp-controller="LoaiTaiLieu" asp-action="Edit" asp-route-id="@Model.DocType.Id" class="btn-figma btn-figma-outline btn-sm">Về form</a>
        </div>
    </div>

    <form asp-area="sohoa" asp-controller="LoaiTaiLieu" asp-action="SeparateSubmit" asp-route-id="@Model.DocType.Id" method="post" id="frmSep">
        @Html.AntiForgeryToken()
        <input type="hidden" name="X" id="hidX" />
        <input type="hidden" name="Y" id="hidY" />
        <input type="hidden" name="W" id="hidW" />
        <input type="hidden" name="H" id="hidH" />
        <div class="card-figma">
            <div class="card-header-figma d-flex justify-content-between align-items-center">
                <h3 class="card-title-figma mb-0">Vùng phân tách</h3>
                <button type="button" class="btn-figma btn-figma-primary btn-sm" id="btnAddSep"><i class="fas fa-plus mr-1"></i>Thêm vùng</button>
            </div>
            <div class="card-content-figma p-0">
                <div class="table-container-figma mb-0">
                    <table class="table table-sm table-figma mb-0" id="sepTable">
                        <thead>
                            <tr><th>X</th><th>Y</th><th>W</th><th>H</th><th style="width:48px;"></th></tr>
                        </thead>
                        <tbody>
                        @foreach (var r in Model.Separates)
                        {
                            <tr>
                                <td><input type="number" class="form-control form-control-sm sep-x" value="@r.X" min="0" /></td>
                                <td><input type="number" class="form-control form-control-sm sep-y" value="@r.Y" min="0" /></td>
                                <td><input type="number" class="form-control form-control-sm sep-w" value="@r.Width" min="0" /></td>
                                <td><input type="number" class="form-control form-control-sm sep-h" value="@r.Height" min="0" /></td>
                                <td><button type="button" class="btn btn-link text-danger btn-sm btnRmSep"><i class="fas fa-times"></i></button></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="mt-3 text-right">
            <button type="submit" class="btn-figma btn-figma-primary"><i class="fas fa-save mr-1"></i>Lưu</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            function rowTpl() {
                var tr = document.createElement('tr');
                tr.innerHTML = '<td><input type="number" class="form-control form-control-sm sep-x" value="0" min="0" /></td>' +
                    '<td><input type="number" class="form-control form-control-sm sep-y" value="0" min="0" /></td>' +
                    '<td><input type="number" class="form-control form-control-sm sep-w" value="0" min="0" /></td>' +
                    '<td><input type="number" class="form-control form-control-sm sep-h" value="0" min="0" /></td>' +
                    '<td><button type="button" class="btn btn-link text-danger btn-sm btnRmSep"><i class="fas fa-times"></i></button></td>';
                return tr;
            }
            document.getElementById('btnAddSep').addEventListener('click', function () {
                document.querySelector('#sepTable tbody').appendChild(rowTpl());
            });
            document.getElementById('sepTable').addEventListener('click', function (e) {
                if (e.target.closest('.btnRmSep')) e.target.closest('tr').remove();
            });
            document.getElementById('frmSep').addEventListener('submit', function () {
                var xs = [], ys = [], ws = [], hs = [];
                document.querySelectorAll('#sepTable tbody tr').forEach(function (tr) {
                    xs.push(tr.querySelector('.sep-x').value || '0');
                    ys.push(tr.querySelector('.sep-y').value || '0');
                    ws.push(tr.querySelector('.sep-w').value || '0');
                    hs.push(tr.querySelector('.sep-h').value || '0');
                });
                document.getElementById('hidX').value = xs.join(',');
                document.getElementById('hidY').value = ys.join(',');
                document.getElementById('hidW').value = ws.join(',');
                document.getElementById('hidH').value = hs.join(',');
            });
        })();
    </script>
}
