@model DocTypeEditPageDto
@{
    var isNew = Model.DocType.Id <= 0;
    ViewData["Title"] = isNew ? "Tạo loại tài liệu" : "Sửa loại tài liệu";
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-area="sohoa" asp-controller="Home" asp-action="Index">Tổng quan</a></li>
    <li class="breadcrumb-item"><a asp-area="sohoa" asp-controller="LoaiTaiLieu" asp-action="Index">Loại tài liệu</a></li>
    <li class="breadcrumb-item active">@(isNew ? "Tạo mới" : "Sửa")</li>
}

<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:40px;height:40px;background:var(--primary-light);color:var(--primary);border-radius:8px;"><i class="fas fa-file-alt"></i></div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);font-size:15px;">@ViewData["Title"]</h6>
                    <div class="text-muted small">Lưu để áp dụng ma trận trường và danh mục.</div>
                </div>
            </div>
            <div class="d-flex flex-wrap" style="gap:8px;">
                <a asp-area="sohoa" asp-controller="LoaiTaiLieu" asp-action="Index" class="btn-figma btn-figma-secondary btn-sm">Quay lại</a>
            </div>
        </div>
    </div>

    <form asp-area="sohoa" asp-controller="LoaiTaiLieu" asp-action="@(isNew ? "CreateSubmit" : "EditSubmit")" asp-route-id="@Model.DocType.Id" method="post" class="border-0 bg-transparent p-0">
        @Html.AntiForgeryToken()
        <div class="card-figma mb-3">
            <div class="card-header-figma">
                <h3 class="card-title-figma mb-0"><i class="fas fa-info-circle mr-2" style="opacity:.85;"></i>Thông tin chung</h3>
            </div>
            <div class="card-content-figma">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group-figma">
                            <label class="label-figma" for="dt-name">Tên <span class="text-danger">*</span></label>
                            <input type="text" id="dt-name" name="Name" class="form-control" value="@Model.DocType.Name" required maxlength="255" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group-figma">
                            <label class="label-figma" for="dt-weight">Thứ tự (Weight)</label>
                            <input type="number" id="dt-weight" name="Weight" class="form-control" value="@Model.DocType.Weight" min="0" />
                        </div>
                    </div>
                </div>
                <div class="form-group-figma">
                    <label class="label-figma" for="dt-desc">Mô tả</label>
                    <textarea id="dt-desc" name="Describe" class="form-control" rows="3">@Model.DocType.Describe</textarea>
                </div>
            </div>
        </div>

        <div class="card-figma mb-3">
            <div class="card-header-figma"><h3 class="card-title-figma mb-0"><i class="fas fa-list mr-2" style="opacity:.85;"></i>Trường mặc định (Hiển thị)</h3></div>
            <div class="card-content-figma p-0">
                <partial name="_DocTypeDefaultFields" model="Model" />
            </div>
        </div>

        <div class="card-figma mb-3">
            <div class="card-header-figma"><h3 class="card-title-figma mb-0"><i class="fas fa-plus-circle mr-2" style="opacity:.85;"></i>Trường mở rộng (Field 1-25)</h3></div>
            <div class="card-content-figma p-0">
                <partial name="_DocTypeExtendedFields" model="Model" />
            </div>
        </div>

        <div class="d-flex justify-content-end flex-wrap" style="gap:8px;">
            <a asp-area="sohoa" asp-controller="LoaiTaiLieu" asp-action="Index" class="btn-figma btn-figma-secondary">Hủy</a>
            <button type="submit" class="btn-figma btn-figma-primary"><i class="fas fa-save mr-1"></i>Lưu</button>
        </div>
    </form>
</div>
