@model SHTL.Modules.Shared.Contracts.Dtos.ConstructionDashboardViewModel
@{
    ViewData["Title"] = "Tiến độ thi công";
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-area="dashboard" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
    <li class="breadcrumb-item active">Tiến độ thi công</li>
}

@section Styles {
    <style>
        .metric { display: inline-block; min-width: 96px; text-align: center; border-radius: 8px; padding: 8px 10px; background: #f8f9fa; margin-right: 8px; margin-bottom: 8px; }
        .metric .k { display: block; font-size: 11px; color: #6c757d; }
        .metric .v { font-size: 20px; font-weight: 700; color: #0b7285; line-height: 1.1; }
        .construction-nav-card { transition: all .2s ease; border: 1px solid #e9ecef; }
        .construction-nav-card:hover { transform: translateY(-1px); box-shadow: 0 .3rem .8rem rgba(17, 24, 39, .08); border-color: #d9e2ec; }
    </style>
}
<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:var(--primary-light);color:var(--primary);border-radius:6px;">
                    <i class="fas fa-tasks"></i>
                </div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Tiến độ thi công</h6>
                    <div class="text-muted small">Bảng điều phối phân việc, theo dõi KPI và lương theo khối thi công.</div>
                </div>
            </div>
            <a class="btn-figma btn-figma-primary btn-sm" asp-area="dashboard" asp-controller="Construction" asp-action="Batches">
                <i class="fas fa-layer-group mr-1"></i>Vào quản lý bộ hồ sơ
            </a>
        </div>
    </div>

    <div class="card-figma mb-3">
        <div class="card-content-figma d-flex flex-wrap">
            <span class="metric"><span class="k">Tổng bộ hồ sơ</span><span class="v">@Model.TotalBatches</span></span>
            <span class="metric"><span class="k">Đang chạy</span><span class="v">@Model.ActiveBatches</span></span>
            <span class="metric"><span class="k">Đã hoàn thành</span><span class="v">@Model.CompletedBatches</span></span>
            <span class="metric"><span class="k">Tổng tài liệu</span><span class="v">@Model.TotalDocuments</span></span>
            <span class="metric"><span class="k">Đã xong</span><span class="v">@Model.CompletedDocuments</span></span>
            <span class="metric"><span class="k">Tỷ lệ</span><span class="v">@Model.CompletionPercent.ToString("0.##")%</span></span>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 col-md-6 mb-3">
            <a class="card card-body h-100 text-decoration-none construction-nav-card" asp-area="dashboard" asp-controller="Construction" asp-action="Batches">
                <i class="fas fa-layer-group text-success mb-2"></i>
                <div class="font-weight-bold text-dark">Bộ hồ sơ & phân việc</div>
                <small class="text-muted">Tạo bộ hồ sơ, gán người xử lý theo bước.</small>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <a class="card card-body h-100 text-decoration-none construction-nav-card" asp-area="dashboard" asp-controller="Construction" asp-action="Kpi">
                <i class="fas fa-chart-line text-info mb-2"></i>
                <div class="font-weight-bold text-dark">KPI ngày</div>
                <small class="text-muted">Theo dõi sản lượng, chất lượng, tốc độ xử lý.</small>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <a class="card card-body h-100 text-decoration-none construction-nav-card" asp-area="dashboard" asp-controller="Construction" asp-action="Payroll">
                <i class="fas fa-money-check-alt text-warning mb-2"></i>
                <div class="font-weight-bold text-dark">Payroll</div>
                <small class="text-muted">Tính lương theo KPI và giờ công, chốt tháng.</small>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <a class="card card-body h-100 text-decoration-none construction-nav-card" asp-area="dashboard" asp-controller="Construction" asp-action="FolderProgress">
                <i class="fas fa-folder-open text-primary mb-2"></i>
                <div class="font-weight-bold text-dark">Theo thư mục</div>
                <small class="text-muted">Theo dõi OCR / nhập liệu / kiểm tra theo folder.</small>
            </a>
        </div>
    </div>
</div>
