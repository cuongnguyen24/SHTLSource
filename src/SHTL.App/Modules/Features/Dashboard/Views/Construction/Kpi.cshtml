@model SHTL.Modules.Shared.Contracts.Dtos.ConstructionKpiDashboardViewModel
@{
    ViewData["Title"] = "KPI ngày & Chấm công";
    var isAdmin = (bool?)ViewBag.IsAdmin ?? false;
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-area="dashboard" asp-controller="Construction" asp-action="Index">Tiến độ thi công</a></li>
    <li class="breadcrumb-item active">KPI ngày</li>
}

<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:var(--primary-light);color:var(--primary);border-radius:6px;">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">KPI ngày & chấm công</h6>
                    <div class="text-muted small">Chấm công: đủ chỉ tiêu KPI theo vai trò = 1 công. KPI tính theo số tài liệu hoàn thiện tại bước.</div>
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-end" style="gap:8px;">
                <form method="get" class="d-flex flex-wrap align-items-end" style="gap:8px;">
                    <div><label class="small text-muted mb-1 d-block">Từ ngày</label><input class="form-control form-control-sm" type="date" name="from" value="@Model.FromDate.ToString("yyyy-MM-dd")" /></div>
                    <div><label class="small text-muted mb-1 d-block">Đến ngày</label><input class="form-control form-control-sm" type="date" name="to" value="@Model.ToDate.ToString("yyyy-MM-dd")" /></div>
                    <button class="btn-figma btn-figma-primary" type="submit">Lọc</button>
                </form>
            </div>
        </div>
    </div>

    <div class="card-figma mb-3">
        <div class="card-header-figma pb-0">
            <ul class="nav nav-tabs border-0" id="kpiTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link active font-weight-bold" id="kpi-role-tab" data-toggle="tab" href="#kpi-role-pane" role="tab">Cấu hình KPI theo vai trò</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link font-weight-bold" id="kpi-period-tab" data-toggle="tab" href="#kpi-period-pane" role="tab">Thống kê theo thời gian</a>
                </li>
            </ul>
        </div>
        <div class="card-content-figma">
            <div class="tab-content" id="kpiTabContent">
                <div class="tab-pane fade show active" id="kpi-role-pane" role="tabpanel">
                    <p class="text-muted small mb-3">3 vai trò: <strong>CheckScan</strong> (gộp scan 1 + 2), <strong>Extract</strong>, <strong>Check sau Extract</strong>.</p>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-striped table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Vai trò</th>
                                    <th>Chỉ tiêu/ngày</th>
                                    <th>Chất lượng tối thiểu</th>
                                    <th>Mốc thưởng</th>
                                    @if (isAdmin)
                                    {
                                        <th class="text-right" style="width:250px;">Thao tác</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cfg in Model.RoleConfigs)
                                {
                                    <tr>
                                        <td class="font-weight-bold text-primary">@cfg.DisplayName</td>
                                        <td>@cfg.DailyTarget</td>
                                        <td>@cfg.MinQualityPercent.ToString("0.##")%</td>
                                        <td>
                                            @if (!cfg.BonusTiers.Any())
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                            else
                                            {
                                                @string.Join("; ", cfg.BonusTiers.Select((x, i) => $"Mốc {i + 1}: {x.MinProcessed} TL, {x.MinQualityPercent:0.##}%, {x.BonusAmount:N0}đ"))
                                            }
                                        </td>
                                        @if (isAdmin)
                                        {
                                            <td class="text-right">
                                                <a asp-action="CreateKpiConfig" asp-route-role="@cfg.Role" class="btn-figma btn-figma-outline btn-sm">Tạo mới</a>
                                                <a asp-action="EditKpiConfig" asp-route-role="@cfg.Role" class="btn-figma btn-figma-primary btn-sm">Sửa</a>
                                                <form method="post" asp-action="DeleteKpiConfig" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="role" value="@cfg.Role" />
                                                    <button type="submit" class="btn-figma btn-figma-outline btn-sm" onclick="return confirm('Xóa cấu hình KPI của vai trò @cfg.DisplayName?');">Xóa</button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade" id="kpi-period-pane" role="tabpanel">
                    <div class="d-flex flex-wrap mb-3" style="gap:8px;">
                        @foreach (var period in Model.PeriodStats)
                        {
                            <button type="button" class="btn-figma btn-figma-outline btn-sm js-kpi-period-btn" data-period="@period.Key">@period.Label</button>
                        }
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-striped table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Kỳ</th>
                                    <th>Từ ngày</th>
                                    <th>Đến ngày</th>
                                    <th>Xử lý</th>
                                    <th>Chất lượng TB</th>
                                    <th>Đạt KPI</th>
                                    <th>Công</th>
                                    <th>Thưởng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.PeriodStats)
                                {
                                    <tr class="js-kpi-period-row" data-period="@p.Key">
                                        <td class="font-weight-bold text-primary">@p.Label</td>
                                        <td>@p.FromDate.ToString("dd/MM/yyyy")</td>
                                        <td>@p.ToDate.ToString("dd/MM/yyyy")</td>
                                        <td>@p.TotalProcessed</td>
                                        <td>@p.AverageQuality.ToString("0.##")%</td>
                                        <td>@p.KpiMetRows/@p.TotalRows</td>
                                        <td>@p.TotalWorkDays.ToString("0.##")</td>
                                        <td>@p.TotalBonus.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card-figma mb-3">
        <div class="card-header-figma">
            <h3 class="card-title-figma mb-0">Chấm công</h3>
        </div>
        <div class="card-content-figma p-0">
            <div class="table-responsive">
                <table class="table table-sm table-bordered table-striped table-hover mb-0">
                    <thead class="table-light"><tr><th>Ngày</th><th>User</th><th>Họ tên</th><th>Công</th><th>Đủ KPI</th><th>Ghi chú</th></tr></thead>
                    <tbody>
                    @if (!Model.Attendance.Any()) { <tr><td colspan="6" class="text-center text-muted p-3">Chưa có dữ liệu chấm công.</td></tr> }
                    else
                    {
                        foreach (var a in Model.Attendance)
                        {
                            <tr>
                                <td>@a.WorkDate.ToString("dd/MM/yyyy")</td>
                                <td>@a.UserName</td>
                                <td>@a.FullName</td>
                                <td>@(a.IsPresent ? "1" : "0")</td>
                                <td>@(a.IsPresent ? "Có" : "Không")</td>
                                <td class="small text-muted">@(a.Notes ?? "-")</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card-figma">
        <div class="card-header-figma">
            <h3 class="card-title-figma mb-0">KPI theo ngày</h3>
        </div>
        <div class="card-content-figma p-0">
            <div class="table-responsive">
                <table class="table table-sm table-bordered table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ngày</th><th>User</th><th>Bước</th><th>Xử lý</th><th>Chỉ tiêu</th><th>Đạt KPI</th>
                            <th>Đạt</th><th>Lỗi</th><th>Trả lại</th><th>Chất lượng</th><th>Thưởng</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Kpis.Any()) { <tr><td colspan="11" class="text-center text-muted p-3">Chưa có dữ liệu KPI.</td></tr> }
                    else
                    {
                        foreach (var k in Model.Kpis)
                        {
                            <tr class="@(k.KpiMet ? "table-success" : "")">
                                <td>@k.WorkDate.ToString("dd/MM/yyyy")</td>
                                <td>@k.UserName</td>
                                <td>@k.StepDisplayName</td>
                                <td>@k.DocumentsProcessed</td>
                                <td>@k.DailyTarget</td>
                                <td>@(k.KpiMet ? "Có" : "Không")</td>
                                <td>@k.DocumentsPassed</td>
                                <td>@k.DocumentsFailed</td>
                                <td>@k.DocumentsReturned</td>
                                <td>@k.QualityScore.ToString("0.##")%</td>
                                <td>@(k.BonusAmount > 0 ? k.BonusAmount.ToString("N0") : "-")</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const rows = Array.from(document.querySelectorAll('.js-kpi-period-row'));
            const buttons = Array.from(document.querySelectorAll('.js-kpi-period-btn'));
            if (rows.length === 0 || buttons.length === 0) return;

            function selectPeriod(period) {
                rows.forEach(r => {
                    r.style.display = r.getAttribute('data-period') === period ? '' : 'none';
                });
                buttons.forEach(b => {
                    if (b.getAttribute('data-period') === period) {
                        b.classList.remove('btn-figma-outline');
                        b.classList.add('btn-figma-primary');
                    } else {
                        b.classList.remove('btn-figma-primary');
                        b.classList.add('btn-figma-outline');
                    }
                });
            }

            buttons.forEach(b => b.addEventListener('click', function () { selectPeriod(this.getAttribute('data-period')); }));
            selectPeriod('7d');
        })();
    </script>
}
