@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}
@section Breadcrumb {
    <li class="breadcrumb-item active">Lỗi</li>
}

<div class="card-figma">
    <div class="card-content-figma py-4 px-4">
        <h4 class="font-weight-bold mb-2"><i class="fas fa-bug mr-2 text-warning"></i>Đã xảy ra lỗi</h4>
        <p class="text-muted mb-3">Vui lòng thử lại hoặc xem nhật ký ứng dụng.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mb-0"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
    </div>
</div>
