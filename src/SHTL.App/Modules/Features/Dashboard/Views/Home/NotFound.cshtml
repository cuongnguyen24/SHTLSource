@{
    ViewData["Title"] = "Không tìm thấy";
    Layout = "_Layout";
    ViewData["SidebarPartial"] = "_SidebarDashboard";
}
@section Breadcrumb {
    <li class="breadcrumb-item active">404</li>
}

<div class="d-flex justify-content-center align-items-center py-5">
    <div class="card-figma text-center" style="max-width: 420px;">
        <div class="card-content-figma py-5 px-4">
            <div class="mb-3" style="font-size: 3rem; color: var(--warning);"><i class="fas fa-search"></i></div>
            <h4 class="font-weight-bold mb-2">Không tìm thấy trang</h4>
            <p class="text-muted small mb-4">Đường dẫn không tồn tại hoặc đã được di chuyển.</p>
            <a asp-area="dashboard" asp-controller="Home" asp-action="Index" class="btn-figma btn-figma-primary">Về trang chủ</a>
        </div>
    </div>
</div>
