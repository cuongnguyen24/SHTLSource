@{
    ViewData["Title"] = "Bạn không có quyền";
    Layout = "_Layout";
    ViewData["SidebarPartial"] = "_SidebarDashboard";
    var returnUrl = ViewData["ReturnUrl"] as string;
}
@section Breadcrumb {
    <li class="breadcrumb-item active">Không có quyền</li>
}

<div class="d-flex justify-content-center align-items-center py-5">
    <div class="card-figma text-center" style="max-width: 520px;">
        <div class="card-content-figma py-5 px-4">
            <div class="mb-3" style="font-size: 3.5rem; color: var(--danger);">
                <i class="fas fa-lock"></i>
            </div>
            <h4 class="font-weight-bold mb-2">Bạn không có quyền truy cập trang này</h4>
            <p class="text-muted small mb-4">
                Tài khoản của bạn không được cấp vai trò phù hợp cho chức năng này.
                Vui lòng liên hệ quản trị viên để được cấp quyền.
            </p>
            <div class="d-flex flex-wrap justify-content-center" style="gap: 8px;">
                <a asp-area="dashboard" asp-controller="Home" asp-action="Index"
                   class="btn-figma btn-figma-primary">
                    <i class="fas fa-home mr-1"></i> Về trang chủ
                </a>
                <a href="javascript:history.back()" class="btn-figma btn-figma-outline">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại
                </a>
            </div>
            @if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                <div class="mt-3 small text-muted">
                    Trang yêu cầu: <code>@returnUrl</code>
                </div>
            }
        </div>
    </div>
</div>
