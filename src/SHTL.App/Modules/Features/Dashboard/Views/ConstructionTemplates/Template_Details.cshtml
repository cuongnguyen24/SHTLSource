@{
    ViewData["Title"] = "Template Details";
}
<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:var(--primary-light);color:var(--primary);border-radius:6px;">
                    <i class="fas fa-info-circle"></i>
                </div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Template Details Header</h6>
                    <div class="text-muted small">Thong tin tong quan doi tuong.</div>
                </div>
            </div>
            <button class="btn-figma btn-figma-primary btn-sm" type="button">Cap nhat</button>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-5 mb-3">
            <div class="card-figma h-100">
                <div class="card-header-figma"><h3 class="card-title-figma mb-0">Khoi thong tin 1</h3></div>
                <div class="card-content-figma">
                    <p class="text-muted mb-0">Noi dung mau.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-7 mb-3">
            <div class="card-figma h-100">
                <div class="card-header-figma"><h3 class="card-title-figma mb-0">Khoi thong tin 2</h3></div>
                <div class="card-content-figma p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr><th>Cot A</th><th>Cot B</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Gia tri 1</td><td>Gia tri 2</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
