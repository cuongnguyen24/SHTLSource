@{
    ViewData["Title"] = "Mẫu giao diện thi công";
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-area="dashboard" asp-controller="Construction" asp-action="Index">Tiến độ thi công</a></li>
    <li class="breadcrumb-item active">Mẫu giao diện</li>
}
<div class="layout-expanded">
    <div class="frame-figma mb-3">
        <div class="frame-header">
            <div class="d-flex align-items-center">
                <div class="mr-3 d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:var(--primary-light);color:var(--primary);border-radius:6px;">
                    <i class="fas fa-copy"></i>
                </div>
                <div>
                    <h6 class="mb-0 font-weight-bold" style="color:var(--primary);">Template View (Internal)</h6>
                    <div class="text-muted small">Thu muc mau de doi dev copy bo cuc giao dien. Khong gan route, khong render tren web.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card-figma">
        <div class="card-content-figma">
            <p class="mb-2"><strong>Muc dich:</strong> Giu cac mau layout dong bo cho module Construction.</p>
            <ul class="mb-0">
                <li><code>Template_List.cshtml</code>: Header + filter + table list.</li>
                <li><code>Template_Details.cshtml</code>: Summary + blocks + table chi tiet.</li>
                <li><code>Template_Form.cshtml</code>: Form CRUD co bo cuc card-figma.</li>
            </ul>
        </div>
    </div>
</div>
