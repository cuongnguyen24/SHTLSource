        $(function() {
            // Global Select2 initialization for premium Figma components
            if (typeof window.initSelect2 === 'function') {
                // Initialize both .select2-modern (legacy) and .select2 (new standard)
                window.initSelect2('.select2-modern, .select2');
            }
        });
    </script> *@
    
    <!-- Figma DataTables Helper -->
    <script src="~/js/figma-datatables-helper.js" asp-append-version="true"></script>

    <!-- File Upload Component -->
    <script src="~/js/file-upload.js" asp-append-version="true"></script>

    <!-- Shared Metadata Helpers -->
    <script src="~/js/filemanager/metadata-core.js" asp-append-version="true"></script>

    <!-- File Preview Module (dùng toàn site) -->
    <script src="~/js/file-preview.js" asp-append-version="true"></script>

    <script src="~/js/shtl-ajax.js" asp-append-version="true"></script>

    <script>
        // Update header time display every minute
        function updateHeaderTime() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const year = now.getFullYear();

            const display = `${hours}:${minutes} — ${day}/${month}/${year}`;
            const element = document.getElementById('current-time-display');
            if (element) {
                element.innerText = display;
                element.title = `Cập nhật lúc ${hours}:${minutes}`;
            }
        }

        $(document).ready(function() {
            // Initialize time display
            updateHeaderTime();
            setInterval(updateHeaderTime, 60000);

            // ========================================
            // SIDEBAR TOGGLE LOGIC (Desktop + Mobile)
            // ========================================
            
            // Load sidebar state from localStorage
            const sidebarCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
            const $body = $('body');
            const $layoutWrapper = $('.layout-wrapper');
            
            // Apply saved state on page load
            if (sidebarCollapsed && $(window).width() >= 768) {
                $body.addClass('sidebar-collapsed');
            }
            
            // Sidebar toggle button click
            $('#sidebarToggle').on('click', function() {
                if ($(window).width() >= 768) {
                    // Desktop: Toggle collapsed state
                    $body.toggleClass('sidebar-collapsed');
                    const isCollapsed = $body.hasClass('sidebar-collapsed');
                    localStorage.setItem('sidebarCollapsed', isCollapsed);
                } else {
                    // Mobile: Toggle active/show state (slide in/out)
                    $('.sidebar-figma').toggleClass('active show');
                    $body.toggleClass('sidebar-open');
                }
            });

            // Close sidebar when clicking outside on mobile
            $(document).on('click', function(e) {
                if ($(window).width() < 768) {
                    if (!$(e.target).closest('.sidebar-figma, #sidebarToggle').length) {
                        $('.sidebar-figma').removeClass('active show');
                        $body.removeClass('sidebar-open');
                    }
                }
            });

            // Handle window resize - reset mobile/desktop states
            let resizeTimer;
            $(window).on('resize', function() {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(function() {
                    if ($(window).width() >= 768) {
                        // Desktop mode - remove mobile classes, restore saved collapsed state
                        $('.sidebar-figma').removeClass('active show');
                        $body.removeClass('sidebar-open');
                        const savedCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
                        if (savedCollapsed) {
                            $body.addClass('sidebar-collapsed');
                        } else {
                            $body.removeClass('sidebar-collapsed');
                        }
                    } else {
                        // Mobile mode - remove desktop collapsed class
                        $body.removeClass('sidebar-collapsed');
                    }
                }, 250);
            });

            // ========================================
            // COLLAPSED SIDEBAR SUBMENU POPOVER
            // ========================================
            
            let activePopover = null;
            
            // Handle click on menu items with submenus when sidebar is collapsed
            $(document).on('click', '.sidebar-collapsed .nav-link-figma[data-has-submenu="true"]', function(e) {
                // SAFETY CHECK: Only proceed if sidebar is actually collapsed (width <= 70px)
                if ($('.sidebar-figma').outerWidth() > 70) return;
                
                e.preventDefault();
                e.stopPropagation();
                
                // Close existing popover if any
                if (activePopover) {
                    activePopover.remove();
                    activePopover = null;
                }
                
                const $this = $(this);
                const menuTitle = $this.data('menu-title');
                const menuItems = $this.data('menu-items');
                
                if (!menuItems || menuItems.length === 0) return;
                
                // Get position
                const rect = this.getBoundingClientRect();
                const top = rect.top;
                
                // Create popover
                let popoverHtml = '<div class="sidebar-submenu-popover show" style="top: ' + top + 'px;">';
                popoverHtml += '<div style="padding: 8px 12px; font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid var(--border-color); margin-bottom: 4px;">' + menuTitle + '</div>';
                
                menuItems.forEach(function(item) {
                    const activeClass = item.active ? 'active' : '';
                    const url = '/' + item.controller + '/' + item.action;
                    popoverHtml += '<a href="' + url + '" class="submenu-item ' + activeClass + '">' + item.title + '</a>';
                });
                
                popoverHtml += '</div>';
                
                activePopover = $(popoverHtml);
                $('body').append(activePopover);
                
                // Position adjustment if goes off screen
                const popoverHeight = activePopover.outerHeight();
                const windowHeight = $(window).height();
                if (top + popoverHeight > windowHeight) {
                    activePopover.css('top', Math.max(10, windowHeight - popoverHeight - 10) + 'px');
                }
            });
            
            // Close popover when clicking outside
            $(document).on('click', function(e) {
                if (activePopover && !$(e.target).closest('.sidebar-submenu-popover, .nav-link-figma').length) {
                    activePopover.remove();
                    activePopover = null;
                }
            });
            
            // Close popover when sidebar is expanded
            $('#sidebarToggle').on('click', function() {
                if (activePopover) {
                    activePopover.remove();
                    activePopover = null;
                }
            });

            // Toastr Notifications from TempData
            @{
                var successMsg = TempData["Success"] != null ? Json.Serialize(TempData["Success"].ToString()) : null;
                var errorMsg = TempData["Error"] != null ? Json.Serialize(TempData["Error"].ToString()) : null;
                var warningMsg = TempData["Warning"] != null ? Json.Serialize(TempData["Warning"].ToString()) : null;
                var infoMsg = TempData["Info"] != null ? Json.Serialize(TempData["Info"].ToString()) : null;
            }

            @if (successMsg != null)
            {
                <text>
                toastr.success(@Html.Raw(successMsg), 'Thành công', {
                    timeOut: 5000,
                    closeButton: true,
                    progressBar: true,
                    positionClass: 'toast-top-right'
                });
                </text>
            }
            @if (errorMsg != null)
            {
                <text>
                toastr.error(@Html.Raw(errorMsg), 'Lỗi', {
                    timeOut: 8000,
                    closeButton: true,
                    progressBar: true,
                    positionClass: 'toast-top-right'
                });
                </text>
            }
            @if (warningMsg != null)
            {
                <text>
                toastr.warning(@Html.Raw(warningMsg), 'Cảnh báo', {
                    timeOut: 5000,
                    closeButton: true,
                    progressBar: true,
                    positionClass: 'toast-top-right'
                });
                </text>
            }
            @if (infoMsg != null)
            {
                <text>
                toastr.info(@Html.Raw(infoMsg), 'Thông tin', {
                    timeOut: 5000,
                    closeButton: true,
                    progressBar: true,
                    positionClass: 'toast-top-right'
                });
                </text>
            }

            // ========================================
            // GLOBAL AJAX ERROR HANDLER - Session Expiration
            // ========================================
            
            // Setup global AJAX error handler for 401 Unauthorized
            $(document).ajaxError(function(event, jqXHR, ajaxSettings, thrownError) {
                // Check if response is 401 Unauthorized (session expired or invalid token)
                if (jqXHR.status === 401) {
                    console.warn('Session expired (401 Unauthorized). Redirecting to login...');
                    
                    // Show notification before redirect
                    toastr.warning('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.', 'Hết phiên', {
                        timeOut: 3000,
                        closeButton: true,
                        progressBar: true,
                        positionClass: 'toast-top-right'
                    });
                    
                    // Redirect to login after 1 second
                    setTimeout(function() {
                        window.location.href = '/account/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                    }, 1000);
                }
                // Check if response is 403 Forbidden (no permission)
                else if (jqXHR.status === 403) {
                    toastr.error('Bạn không có quyền thực hiện thao tác này.', 'Không có quyền', {
                        timeOut: 5000,
                        closeButton: true,
                        progressBar: true,
                        positionClass: 'toast-top-right'
                    });
                }
            });

            // Smooth scroll behavior for content area
            $('#page-content-scroll').on('scroll', function() {
                const scrollTop = $(this).scrollTop();
                if (scrollTop > 20) {
                    $('.header-container').addClass('scrolled');
                } else {
                    $('.header-container').removeClass('scrolled');
                }
            });

            // Auto-hide notifications after some time
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 10000);

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
