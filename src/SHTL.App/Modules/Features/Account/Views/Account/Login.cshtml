@model LoginRequest
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_LoginLayout";
}

<div class="login-box">
    <div class="login-card">
        <div class="login-header">
            <div class="brand-logo" style="background: var(--primary-color); border-radius: 12px; width: 60px; height: 60px; margin-bottom: 16px;">
                <span style="font-weight: 700; font-size: 20px;">SHTL</span>
            </div>
            <h1 class="login-title" style="font-size: 22px; color: var(--primary-color) !important;">HỆ THỐNG SỐ HÓA TÀI LIỆU</h1>
            <p class="login-subtitle" style="font-size: 14px; color: var(--text-muted) !important; margin-top: 4px;">Đăng nhập để làm việc với quy trình tài liệu</p>
        </div>
        <div class="login-card-body" style="padding: 20px 40px 40px !important;">
            <form asp-area="account" asp-controller="Account" asp-action="Login" method="post">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert" style="font-size: 13px; border-radius: 8px;">
                        @TempData["Success"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" name="returnUrl" id="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="form-group mb-3">
                    <label class="font-weight-600 mb-1" style="font-size: 13px; color: var(--text-primary);" asp-for="UserName"></label>
                    <div class="input-group">
                        <input asp-for="UserName" class="form-control" placeholder="Nhập tên đăng nhập" autocomplete="username" style="height: 44px; font-size: 14px; border: 1px solid var(--border-color); border-radius: 8px;" />
                    </div>
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="font-weight-600 mb-1" style="font-size: 13px; color: var(--text-primary);" asp-for="Password"></label>
                    <div class="input-group text-muted">
                        <input asp-for="Password" class="form-control" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" style="height: 44px; font-size: 14px; border: 1px solid var(--border-color); border-radius: 8px;" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group mb-4 d-flex justify-content-between align-items-center">
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" asp-for="RememberMe" id="RememberMe">
                        <label class="custom-control-label" for="RememberMe" style="font-size: 13px; color: var(--text-muted); cursor: pointer;">Ghi nhớ đăng nhập</label>
                    </div>
                </div>

                <div class="mb-4">
                    <button type="submit" class="btn btn-primary btn-block" style="height: 46px; background: var(--primary-color); border-radius: 8px; font-weight: 600; font-size: 15px;">
                        Đăng nhập
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('.login-card-body .form-control').focus(function () {
                $(this).closest('.input-group').addClass('focus');
            }).blur(function () {
                $(this).closest('.input-group').removeClass('focus');
            });
        });
    </script>
}
