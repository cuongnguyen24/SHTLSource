@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi máy chủ";
    Layout = "_Layout";
    ViewData["SidebarPartial"] = "_SidebarDashboard";
}
@section Breadcrumb {
    <li class="breadcrumb-item active">Lỗi</li>
}

<div class="d-flex justify-content-center py-5">
    <div class="card-figma text-center" style="max-width: 480px;">
        <div class="card-content-figma py-5 px-4">
            <div class="mb-3" style="font-size: 3rem; color: var(--destructive);"><i class="fas fa-exclamation-triangle"></i></div>
            <h4 class="font-weight-bold mb-2">Đã xảy ra lỗi</h4>
            <p class="text-muted small mb-3">Vui lòng thử lại sau.</p>
            @if (Model.ShowRequestId)
            {
                <p class="text-muted small mb-4"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
            }
            <a asp-area="account" asp-controller="Home" asp-action="Index" class="btn-figma btn-figma-primary">Về tài khoản</a>
        </div>
    </div>
</div>
