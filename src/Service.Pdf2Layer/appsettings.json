{
  "WindowsService": {
    "ServiceName": "SHTL Pdf2Layer",
    "EventLogSource": "SHTL.Service.Pdf2Layer"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ShtlDB;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Storage": {
    "RootPath": "E:\\SHTL\\Files"
  },
  "SearchablePdf": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "PythonExecutable": "python",
    "ScriptRelativePath": "tools/searchable-pdf/generate_searchable_pdf.py",
    "AutoInstallPythonDependencies": true,
    "AutoProvisionEmbeddedPython": true,
    "EmbeddedPythonVersion": "3.12.10",
    "EmbeddedPythonDownloadUrl": null,
    "GetPipUrl": "https://bootstrap.pypa.io/get-pip.py",
    "RequirementsRelativePath": "tools/searchable-pdf/requirements.txt",
    "OfflineWheelhouseRelativePath": null,
    "NumberOfPagesRunInPDF2Layer": 0,
    "LogRootPath": null,
    "TimeoutSeconds": 900,
    "StaleProcessingMinutes": 45,
    "RenderDpi": 150
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
